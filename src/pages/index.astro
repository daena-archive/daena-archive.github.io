---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import StatusBadge from '../components/StatusBadge.astro';
import ArchiveCard from '../components/ArchiveCard.astro';
import ArchiveFrame from '../components/home/ArchiveFrame.astro';
import { entrySlug, siteConfig, withBase } from '../config/site';
import {
  Folder,
  History,
  WifiOff,
  Info,
  Crown,
  Users,
  PenTool,
  Sword,
  TreePine,
  ArrowRight,
} from 'lucide-static';

const plugins = (await getCollection('plugins')).sort((a, b) =>
  a.data.name.localeCompare(b.data.name),
);

const keeps = [
  {
    icon: Folder,
    title: 'Plain files',
    text: 'Daena is built around local projects, open formats, and user-controlled files. Your archive stays useful outside the application that created it.',
    href: '/docs/project-storage/how-projects-are-stored/',
    link: 'How projects are stored',
  },
  {
    icon: History,
    title: 'Snapshots',
    text: 'Browse snapshots of the archive, inspect earlier states, and recover work when the project changes direction. Use Git when you want history and remotes.',
    href: '/docs/snapshots-git/snapshots/',
    link: 'Learn about snapshots',
  },
  {
    icon: WifiOff,
    title: 'Works offline',
    text: 'Keep projects on your own machine and work without a connection. Free and open source, with no subscription.',
    href: '/docs/getting-started/',
    link: 'Get started',
  },
];
---

<BaseLayout pageClass="home">
  <section class="hero" aria-labelledby="hero-title">
    <picture class="hero-art">
      <source
        media="(max-width: 700px)"
        srcset={withBase('/images/hero-map-960.webp')}
        type="image/webp"
      />
      <source srcset={withBase('/images/hero-map.webp')} type="image/webp" />
      <img
        src={withBase('/images/hero-map.png')}
        alt="Hand-drawn map of Eldermere, with teal seas, forest terrain, mountains, and navigation lines"
        width="1536"
        height="1024"
        fetchpriority="high"
      />
    </picture>
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="shell hero-inner">
      <div class="hero-copy">
        <span class="eyebrow">A private place for impossible worlds</span>
        <h1 id="hero-title" class="display-heading">
          Build the world <em class="accent-italic">behind the story.</em>
        </h1>
        <p class="lede">
          Daena Archive is a local-first worldbuilding studio. Shape characters, places, factions,
          houses, languages, timelines, maps, and more — all connected.
        </p>
        <div class="button-row">
          <a class="btn btn--primary btn--lg" href={withBase('/docs/')}
            >Read the docs <span aria-hidden="true" set:html={ArrowRight} /></a
          >
          <a class="btn btn--quiet btn--lg" href={withBase('/download/')}
            >Download for Desktop <span aria-hidden="true" set:html={ArrowRight} /></a
          >
        </div>
      </div>
      <div class="hero-map-pins" aria-hidden="true">
        <div class="hero-orbit">
          <i class="orbit-ring"></i>
          <i class="orbit-ring orbit-ring-2"></i>
        </div>
        <div class="map-marker marker-crown">
          <span set:html={Crown} />
          <i></i>
        </div>
        <div class="map-marker marker-people">
          <span set:html={Users} />
          <i></i>
        </div>
        <div class="map-marker marker-quill">
          <span set:html={PenTool} />
          <i></i>
        </div>
        <div class="map-marker marker-sword">
          <span set:html={Sword} />
        </div>
        <div class="map-marker marker-tree">
          <span set:html={TreePine} />
          <i></i>
        </div>
      </div>
      <ArchiveCard class="hero-archive-card" />
    </div>
    <div class="shell hero-facts" aria-label="Daena principles">
      <div><strong>100%</strong><span>Offline First</span></div>
      <div><strong>Open Source</strong><span>Apache 2.0</span></div>
      <div><strong>Built for Creators</strong><span>Not for Corporations</span></div>
      <div><strong>Your Data</strong><span>Stays Yours</span></div>
    </div>
  </section>

  <section class="section archive" aria-labelledby="archive-title">
    <div class="content-shell">
      <span class="overline">The archive</span>
      <h2 id="archive-title" class="section-heading">
        Worlds are complicated. <em class="accent-italic">Keeping track of them shouldn’t be.</em>
      </h2>
      <p class="section-copy">Daena brings the pieces of a world into one connected archive.</p>
      <div class="archive__frame">
        <ArchiveFrame />
      </div>
    </div>
  </section>

  <section class="section keep" aria-labelledby="keep-title">
    <div class="content-shell">
      <span class="overline">Ownership</span>
      <h2 id="keep-title" class="section-heading">Your world belongs to you.</h2>
      <div class="keep__grid">
        {
          keeps.map((item) => (
            <article class="panel keep__card">
              <div class="panel__header">
                <span class="keep__icon" aria-hidden="true" set:html={item.icon} />
              </div>
              <div class="panel__body">
                <h3 class="keep__title">{item.title}</h3>
                <p>{item.text}</p>
                <a class="link" href={withBase(item.href)}>
                  {item.link}
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section plugins" aria-labelledby="plugins-title">
    <div class="content-shell">
      <div class="plugins__head">
        <h2 id="plugins-title" class="section-heading">Plugins</h2>
        <a class="link" href={withBase('/plugins/')}>Browse the registry</a>
      </div>
      <ul class="plugins__grid">
        {
          plugins.map((plugin) => (
            <li>
              <a
                class="panel panel--interactive plugin"
                href={withBase(`/plugins/${entrySlug(plugin.id)}/`)}
              >
                <span class="plugin__name">{plugin.data.name}</span>
                <span class="plugin__summary">{plugin.data.summary}</span>
                <span class="plugin__foot">
                  <code>{plugin.data.version}</code>
                  {plugin.data.status && <StatusBadge status={plugin.data.status} />}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <div class="notice plugins__notice" role="status">
        <Fragment set:html={Info} />
        <strong>Help when you ask for it.</strong>
        <span>
          AI is optional: nothing happens until you opt in, and every result is a proposal you
          accept or reject.{' '}
          <a class="link" href={withBase('/docs/ai/enabling-ai/')}>Read about AI in Daena</a>
        </span>
      </div>
    </div>
  </section>

  <section class="get" aria-labelledby="get-title">
    <div class="content-shell get__row">
      <div>
        <h2 id="get-title" class="section-heading">
          Build your archive. <em class="accent-italic">Keep it yours.</em>
        </h2>
        <p class="section-copy">
          Daena Archive is free and open source. Download the beta, explore the source, or help
          shape what comes next.
        </p>
      </div>
      <div class="get__actions">
        <a class="btn btn--primary btn--lg" href={withBase('/download/')}>Download Daena</a>
        <a class="link" href={siteConfig.releases}>All releases on GitHub</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: min(57rem, calc(100vh - var(--header-height)));
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--canvas);
    color: var(--ink);
  }
  .hero-art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hero-art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .hero-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--canvas) 98%, transparent) 0%,
      color-mix(in srgb, var(--canvas) 91%, transparent) 31%,
      color-mix(in srgb, var(--canvas) 15%, transparent) 61%,
      color-mix(in srgb, var(--canvas) 2%, transparent) 100%
    );
  }
  .hero-inner {
    position: relative;
    flex: 1;
    display: flex;
    align-items: center;
  }
  .hero-copy {
    position: relative;
    z-index: 4;
    width: min(43rem, 52%);
    padding: 5rem 0 3rem 3rem;
  }
  .hero-copy .display-heading {
    max-width: none;
    font-weight: 400;
    font-size: clamp(2.8rem, 6vw, 6.4rem);
    line-height: 0.92;
    letter-spacing: -0.055em;
  }
  .hero-copy .accent-italic {
    font-weight: 300;
  }
  .hero-copy .lede {
    max-width: 34rem;
  }
  .hero-map-pins {
    position: absolute;
    z-index: 4;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(58%, 54rem);
    pointer-events: none;
  }
  .hero-orbit {
    position: absolute;
    top: 28%;
    left: 18%;
    width: clamp(16rem, 28vw, 28rem);
    height: clamp(16rem, 28vw, 28rem);
  }
  .orbit-ring {
    position: absolute;
    inset: 0;
    border: 1px dashed color-mix(in srgb, var(--accent) 45%, transparent);
    border-radius: 50%;
  }
  .orbit-ring-2 {
    inset: clamp(1.6rem, 3vw, 3rem);
    border-color: color-mix(in srgb, var(--accent) 30%, transparent);
  }
  :global(.hero-archive-card) {
    position: absolute;
    z-index: 5;
    top: 42%;
    right: 6%;
  }
  .map-marker {
    position: absolute;
    z-index: 4;
    display: grid;
    place-items: center;
  }
  .map-marker span {
    position: relative;
    z-index: 1;
    width: clamp(2.45rem, 3.4vw, 3.2rem);
    height: clamp(2.45rem, 3.4vw, 3.2rem);
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: var(--accent-dark);
    color: var(--on-accent);
    box-shadow: 0 8px 20px color-mix(in srgb, var(--brass-ink) 22%, transparent);
  }
  .map-marker span :global(svg) {
    width: clamp(0.9rem, 1.2vw, 1.15rem);
    height: clamp(0.9rem, 1.2vw, 1.15rem);
  }
  .map-marker i {
    position: absolute;
    width: clamp(5.4rem, 8vw, 7.5rem);
    height: clamp(5.4rem, 8vw, 7.5rem);
    border: 1px dashed color-mix(in srgb, var(--accent) 50%, transparent);
    border-radius: 50%;
  }
  .marker-crown {
    top: 86%;
    left: 42%;
  }
  .marker-crown span {
    background: var(--accent-dark);
  }
  .marker-people {
    top: 12%;
    left: 42%;
  }
  .marker-people span {
    background: var(--accent);
  }
  .marker-people i {
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
  }
  .marker-quill {
    top: 40%;
    left: 12%;
  }
  .marker-quill span {
    background: var(--surface-warm);
    color: var(--ink);
  }
  .marker-sword {
    top: 58%;
    left: 30%;
  }
  .marker-sword span {
    background: var(--surface);
    color: var(--ink);
  }
  .marker-tree {
    top: 16%;
    left: 68%;
  }
  .marker-tree span {
    background: var(--accent-dark);
  }
  .hero-facts {
    position: relative;
    z-index: 4;
    min-height: 6.5rem;
    width: max(42rem, 52%);
    margin-inline: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    align-items: center;
    border-top: 1px solid var(--line);
  }
  .hero-facts div {
    padding-inline: 1.2rem;
    display: grid;
    justify-items: center;
    border-right: 1px solid var(--line);
    color: var(--ink);
  }
  .hero-facts div:last-child {
    border-right: 0;
  }
  .hero-facts strong {
    font: 520 1rem/1.15 var(--font-display);
  }
  .hero-facts span {
    margin-top: 0.15rem;
    color: var(--ink-soft);
    font-size: 0.65rem;
    letter-spacing: 0.02em;
  }
  :global([data-theme='dark']) .hero-art {
    opacity: 0.62;
  }
  :global([data-theme='dark']) .hero-shade {
    background: linear-gradient(
      90deg,
      var(--canvas) 0%,
      color-mix(in srgb, var(--canvas) 94%, transparent) 33%,
      color-mix(in srgb, var(--canvas) 38%, transparent) 66%,
      color-mix(in srgb, var(--canvas) 16%, transparent)
    );
  }

  .archive {
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
  }
  .archive__frame {
    margin-top: var(--space-6);
  }
  .archive .section-copy {
    margin-top: var(--space-3);
  }

  .keep__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-6);
  }
  .keep__icon {
    display: inline-flex;
    color: var(--accent);
  }
  .keep__icon :global(svg) {
    width: 24px;
    height: 24px;
  }
  .keep__title {
    margin-bottom: var(--space-2);
    font-size: 18px;
    line-height: 1.3;
  }
  .keep__card .panel__body p {
    margin-bottom: var(--space-3);
  }

  .plugins {
    padding-block: 0 clamp(3rem, 5vw, 4rem);
  }
  .plugins__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .plugins__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
  }
  .plugin {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    height: 100%;
    padding: var(--space-4) var(--space-5);
    color: var(--ink-soft);
    font: 400 14px/1.6 var(--font-ui);
    text-decoration: none;
  }
  .plugin__name {
    color: var(--ink);
    font: 500 20px/1.2 var(--font-display);
  }
  .plugin__foot {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: auto;
    padding-top: var(--space-2);
  }
  .plugin__foot code {
    color: var(--ink-soft);
    font: 500 12px/1 var(--font-mono);
  }
  .plugins__notice {
    margin-top: var(--space-5);
  }

  .get {
    padding-block: clamp(3rem, 6vw, 4.5rem);
    border-top: 1px solid var(--line);
  }
  .get__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
  }
  .get__row .section-copy {
    margin-top: var(--space-3);
  }
  .get__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }

  @media (max-width: 62rem) {
    .hero {
      min-height: 48rem;
    }
    .hero-copy {
      width: 62%;
    }
    :global(.hero-archive-card) {
      right: 4%;
    }
    .hero-orbit {
      opacity: 0.4;
    }
    .plugins__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 52rem) {
    .keep__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 46rem) {
    .hero {
      min-height: auto;
      padding-bottom: 0;
    }
    .hero-art {
      height: 26rem;
      top: auto;
    }
    .hero-art img {
      object-position: 68% center;
    }
    .hero-shade {
      background: linear-gradient(
        180deg,
        var(--canvas) 0%,
        var(--canvas) 59%,
        color-mix(in srgb, var(--canvas) 20%, transparent) 82%,
        color-mix(in srgb, var(--canvas) 3%, transparent)
      );
    }
    :global([data-theme='dark']) .hero-shade {
      background: linear-gradient(
        180deg,
        color-mix(in srgb, var(--canvas) 0%, transparent) 0%,
        color-mix(in srgb, var(--canvas) 8%, transparent) 18%,
        color-mix(in srgb, var(--canvas) 32%, transparent) 42%,
        color-mix(in srgb, var(--canvas) 62%, transparent) 62%,
        color-mix(in srgb, var(--canvas) 84%, transparent) 82%,
        color-mix(in srgb, var(--canvas) 92%, transparent) 100%
      );
    }
    .hero-inner {
      min-height: auto;
      display: block;
      align-items: flex-start;
    }
    .hero-copy {
      width: 100%;
      padding-top: 4rem;
    }
    .hero-copy .display-heading {
      font-size: clamp(3.5rem, 16vw, 5.6rem);
    }
    :global(.hero-archive-card) {
      position: relative;
      inset: auto;
      width: 15rem;
      margin: 2rem 0 3rem;
    }
    .hero-map-pins {
      display: none;
    }
    .hero-facts {
      width: 100%;
      grid-template-columns: 1fr 1fr;
      padding-block: 0.8rem;
    }
    .hero-facts div {
      padding: 0.8rem;
    }
    .hero-facts div:nth-child(2) {
      border-right: 0;
    }
  }
  @media (max-width: 40rem) {
    .plugins__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .plugins__head {
      flex-wrap: wrap;
    }
  }
</style>
