---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArchiveCard from '../components/ArchiveCard.astro';
import RelationshipGraph from '../components/RelationshipGraph.astro';
import TimelineStrip from '../components/TimelineStrip.astro';
import LanguageSpecimen from '../components/LanguageSpecimen.astro';
import StatusBadge from '../components/StatusBadge.astro';
import { entrySlug, siteConfig, withBase } from '../config/site';
import { Crown, Users, PenTool, Swords, TreePine, ArrowRight, ArrowDown, ArrowUpRight, BookOpen, Clock, MapPin, Languages, PenLine } from 'lucide-static';

const plugins = (await getCollection('plugins')).filter((entry) => entry.data.featured).slice(0, 3);
const showcase = (await getCollection('showcase'))
  .filter((entry) => entry.data.featured)
  .slice(0, 3);
---

<BaseLayout pageClass="home">
  <section class="hero" aria-labelledby="hero-title">
    <picture class="hero-art">
      <source
        media="(max-width: 700px)"
        srcset={withBase('/images/hero-map-960.webp')}
        type="image/webp"
      />
      <source srcset={withBase('/images/hero-map.webp')} type="image/webp" />
      <img
        src={withBase('/images/hero-map.png')}
        alt="Hand-drawn map of Eldermere, with teal seas, forest terrain, mountains, and navigation lines"
        width="1536"
        height="1024"
        fetchpriority="high"
      />
    </picture>
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="shell hero-inner">
      <div class="hero-copy">
        <span class="eyebrow">A private place for impossible worlds</span>
        <h1 id="hero-title" class="display-heading">
          Build the world <em class="accent-italic">behind the story.</em>
        </h1>
        <p class="lede">
          Daena Archive is a local-first worldbuilding studio. Shape characters, places, factions,
          languages, timelines, maps, and more — all connected.
        </p>
        <div class="button-row">
          <a class="button button-primary" href={withBase('/features/')}
            >Explore Features <span aria-hidden="true" set:html={ArrowRight}></span></a
          >
          <a class="button button-secondary" href={withBase('/download/')}
            >Download for Desktop <span aria-hidden="true" set:html={ArrowDown}></span></a
          >
        </div>
      </div>
      <div class="hero-orbit" aria-hidden="true">
        <i class="orbit-ring"></i>
        <i class="orbit-ring orbit-ring-2"></i>
      </div>
      <div class="map-marker marker-crown" aria-hidden="true">
        <span set:html={Crown}></span>
        <i></i>
      </div>
      <div class="map-marker marker-people" aria-hidden="true">
        <span set:html={Users}></span>
        <i></i>
      </div>
      <div class="map-marker marker-quill" aria-hidden="true">
        <span set:html={PenTool}></span>
        <i></i>
      </div>
      <div class="map-marker marker-sword" aria-hidden="true">
        <span class="marker-small" set:html={Swords}></span>
      </div>
      <div class="map-marker marker-tree" aria-hidden="true">
        <span set:html={TreePine}></span>
        <i></i>
      </div>
      <ArchiveCard class="hero-archive-card" />
    </div>
    <div class="shell hero-facts" aria-label="Daena principles">
      <div><strong>100%</strong><span>Offline First</span></div>
      <div><strong>Open Source</strong><span>Apache 2.0</span></div>
      <div><strong>Built for Creators</strong><span>Not for Corporations</span></div>
      <div><strong>Your Data</strong><span>Stays Yours</span></div>
    </div>
  </section>

  <section class="section intro-section">
    <div class="content-shell intro-grid">
      <div>
        <span class="eyebrow">One world · Many threads</span>
        <h2 class="section-heading">
          Worlds are complicated. <em class="accent-italic">Keeping track of them shouldn’t be.</em>
        </h2>
      </div>
      <div class="intro-copy">
        <p>
          Daena brings the pieces of a world into one connected archive. Lore, history, maps,
          languages, writing, and extensions remain close enough to inform one another without
          forcing your work into a single rigid workflow.
        </p>
        <div class="thread-list" aria-label="Connected archive layers">
          <span set:html={BookOpen}></span><span>Lore</span>
          <span set:html={Clock}></span><span>History</span>
          <span set:html={MapPin}></span><span>Place</span>
          <span set:html={Languages}></span><span>Language</span>
          <span set:html={PenLine}></span><span>Writing</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section lore-section">
    <div class="content-shell lore-grid">
      <div class="lore-copy">
        <span class="eyebrow">Lore · Relationships</span>
        <h2 class="feature-heading">Nothing in your world exists in isolation.</h2>
        <p class="section-copy">
          Record people, places, cultures, artifacts, factions, concepts, and the details that make
          them distinct. Connect them through structured relationships, then move through the
          archive without losing the larger picture.
        </p>
        <p class="supporting-line">
          From a single artifact to an entire civilization, Daena keeps context close.
        </p>
        <a class="text-link" href={withBase('/features/lore/')}>Explore Lore</a>
      </div>
      <div class="graph-stage surface">
        <RelationshipGraph />
        <article class="entity-fragment">
          <div><span>PERSON</span><i>•</i><small>12 relationships</small></div>
          <h3>Mira Vale</h3>
          <p>Cartographer of the Tidewatch and keeper of the western soundings.</p>
          <dl>
            <div><dt>Origin</dt><dd>Eldermere</dd></div><div>
              <dt>Culture</dt><dd>Coastfolk</dd>
            </div>
          </dl>
        </article>
      </div>
    </div>
  </section>

  <section class="section timeline-section">
    <div class="content-shell">
      <div class="timeline-intro">
        <div>
          <span class="eyebrow">History · Time</span>
          <h2 class="feature-heading">Give history somewhere to happen.</h2>
        </div>
        <div>
          <p class="section-copy">
            Build timelines for events, eras, characters, and places. Use calendars when your world
            needs them, or keep dates simple when it does not. History should add context—not
            bookkeeping.
          </p>
          <a class="text-link" href={withBase('/features/timeline/')}>Explore Timelines</a>
        </div>
      </div>
      <div class="timeline-stage"><TimelineStrip /></div>
    </div>
  </section>

  <section class="maps-section dark-panel">
    <div class="map-background" aria-hidden="true">
      <picture
        ><source srcset={withBase('/images/hero-map.webp')} type="image/webp" /><img
          src={withBase('/images/hero-map.png')}
          alt=""
          width="1536"
          height="1024"
          loading="lazy"
        /></picture
      >
    </div>
    <div class="content-shell map-content">
      <div class="map-copy">
        <span class="eyebrow">Maps · Place</span>
        <h2 class="section-heading">Every world needs somewhere to exist.</h2>
        <p class="section-copy">
          Keep maps beside the lore they describe. Link places and entities to geography, explore
          generated worlds, and build visual layers that turn a map into part of the archive.
        </p>
        <div class="status-row">
          <StatusBadge status="beta" /><span>Maps is actively evolving</span>
        </div>
        <a class="button button-brass" href={withBase('/features/maps/')}
          >Explore Maps <span aria-hidden="true" set:html={ArrowRight}></span></a
        >
      </div>
      <div class="map-layers" aria-label="Map progression">
        <span class="coordinate">42° 18′ N · 11° 07′ W</span>
        <ol>
          <li><small>01</small><strong>Physical structure</strong><span>Available · Beta</span></li>
          <li><small>02</small><strong>Terrain detail</strong><span>In development</span></li>
          <li><small>03</small><strong>Lore overlays</strong><span>Roadmap</span></li>
        </ol>
      </div>
    </div>
  </section>

  <section class="section language-section">
    <div class="content-shell language-grid">
      <div>
        <span class="eyebrow">Language · Culture</span>
        <h2 class="feature-heading">Let your cultures speak for themselves.</h2>
        <p class="section-copy">
          Develop sounds, words, grammar, and writing systems without separating language from the
          people and places that use it. Start with a name and a few notes, or go deeper when the
          language demands it.
        </p>
        <a class="text-link" href={withBase('/features/languages/')}>Explore Languages</a>
      </div>
      <LanguageSpecimen />
    </div>
  </section>

  <section class="section writing-section">
    <div class="content-shell writing-grid">
      <div class="writing-sheet surface">
        <div class="document-bar">
          <span>MANUSCRIPT · CHAPTER IV</span><span>Saved locally</span>
        </div>
        <h3>The Sounding Bell</h3>
        <p class="first-line">
          At first light, Mira found the tide three marks higher than the tables allowed.
        </p>
        <p>
          Beyond the glass, Eldermere’s eastern quay was already awake. Ropes creaked against wet
          timber, lanterns went dark one by one, and every gull had turned inland.
        </p>
        <span class="reference-chip">@ Mira Vale <i>PERSON</i></span>
        <span class="reference-chip">@ Eldermere <i>PLACE</i></span>
      </div>
      <div>
        <span class="eyebrow">Writing · Context</span>
        <h2 class="feature-heading">Write with the world beside you.</h2>
        <p class="section-copy">
          Keep prose close to the people, places, history, and terminology that shape it. Daena is a
          world archive first, but the archive should never be far away when it is time to write.
        </p>
        <a class="text-link" href={withBase('/features/writing/')}>Explore Writing</a>
      </div>
    </div>
  </section>

  <section class="section ownership-section dark-panel">
    <div class="content-shell ownership-grid">
      <div>
        <span class="eyebrow">Your archive</span>
        <h2 class="section-heading">Your world belongs to you.</h2>
      </div>
      <div>
        <p class="section-copy">
          Daena is built around local projects, open formats, and user-controlled files. Your
          archive should remain useful outside the application that created it.
        </p>
        <p>
          Keep projects on your own machine. Use Git when you want history and remotes. Work with
          portable representations. Extend the studio without giving up ownership of the archive.
        </p>
        <div class="ownership-labels">
          <span>Local-first</span><span>Open source</span><span>Git-friendly</span><span
            >Portable checkpoints</span
          ><span>No subscription</span>
        </div>
      </div>
      <div class="orbit" aria-hidden="true">
        <svg class="orbit-ring-outer" viewBox="0 0 330 330"><circle cx="165" cy="165" r="164" fill="none" stroke="rgba(58,78,67,0.2)" stroke-width="1.5" stroke-dasharray="10 8" /></svg>
        <svg class="orbit-ring-mid" viewBox="0 0 250 250"><circle cx="125" cy="125" r="124" fill="none" stroke="rgba(58,78,67,0.35)" stroke-width="1.5" stroke-dasharray="6 6" /></svg>
        <svg class="orbit-ring-inner" viewBox="0 0 170 170"><circle cx="85" cy="85" r="84" fill="none" stroke="rgba(58,78,67,0.5)" stroke-width="1.5" stroke-dasharray="3 5" /></svg>
        <span>DAENA</span>
      </div>
    </div>
  </section>

  <section class="section snapshots-section">
    <div class="content-shell snapshot-grid">
      <div>
        <span class="eyebrow">Snapshots · History</span>
        <h2 class="feature-heading">Your project has a history too.</h2>
        <p class="section-copy">
          Browse snapshots of the archive, inspect earlier states, and recover work when the project
          changes direction. World history belongs in Timeline. Project history belongs here.
        </p>
        <a class="text-link" href={withBase('/features/snapshots/')}>Learn about snapshots</a>
      </div>
      <div class="snapshot-stack" aria-label="Example project snapshots">
        <article>
          <span>Today · 14:32</span><strong>Connect the Tidewatch to Lantern Marsh</strong><small
            >8 portable files</small
          >
        </article>
        <article>
          <span>Yesterday · 21:08</span><strong>Revise Coastfolk language notes</strong><small
            >12 portable files</small
          >
        </article>
        <article>
          <span>Aug 18 · 09:16</span><strong>Before map boundary revision</strong><small
            >5 portable files</small
          >
        </article>
      </div>
    </div>
  </section>

  <section class="section plugins-section">
    <div class="content-shell">
      <div class="section-header-row">
        <div>
          <span class="eyebrow">Extensions</span><h2 class="feature-heading">
            Make the studio your own.
          </h2>
        </div>
        <div>
          <p class="section-copy">
            Modules and plugins add focused capabilities through versioned, permission-aware
            contracts.
          </p><a class="text-link" href={withBase('/plugins/')}>Browse the registry</a>
        </div>
      </div>
      <div class="plugin-preview-grid">
        {
          plugins.map((plugin, index) => (
            <article class={`plugin-preview plugin-tone-${index + 1}`}>
              <div class="plugin-art" aria-hidden="true">
                <>
                  <i />
                  <i />
                  <span>{plugin.data.name.charAt(0)}</span>
                </>
              </div>
              <div class="plugin-body">
                <>
                  <StatusBadge status={plugin.data.status} />
                  <h3>{plugin.data.name}</h3>
                  <p>{plugin.data.summary}</p>
                  <small>
                    {plugin.data.package} · v{plugin.data.version}
                  </small>
                  <a
                    href={withBase(`/plugins/${entrySlug(plugin.id)}/`)}
                    aria-label={`View ${plugin.data.name}`}
                  >
                    View module <span aria-hidden="true" set:html={ArrowRight}></span>
                  </a>
                </>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section ai-section">
    <div class="content-shell ai-grid surface">
      <div class="ai-copy">
        <span class="eyebrow">Optional AI</span>
        <h2 class="feature-heading">Help when you ask for it.</h2>
        <p class="section-copy">
          Use language models for rewriting, expansion, or context-aware assistance when they are
          useful. Choose local models when you want the workflow to remain on your machine.
        </p>
        <div class="status-row">
          <StatusBadge status="experimental" /><span>Opt-in · proposal only</span>
        </div>
        <a class="text-link" href={withBase('/features/ai/')}>Read about AI in Daena</a>
      </div>
      <div class="proposal-card">
        <span>REWRITE PROPOSAL</span>
        <p>“The bells beneath the water were older than the city above them.”</p>
        <div class="proposal-actions" role="group" aria-label="Example proposal actions">
          <span>Keep original</span><span>Accept proposal</span>
        </div>
        <small>Nothing changes until you choose.</small>
      </div>
    </div>
  </section>

  <section class="section showcase-section">
    <div class="content-shell">
      <div class="section-header-row">
        <div>
          <span class="eyebrow">From the archive</span><h2 class="feature-heading">
            See how a connected world takes shape.
          </h2>
        </div>
        <div>
          <p class="section-copy">
            The first collection uses clearly labeled demonstration archives. Community submissions
            can follow through a moderated workflow.
          </p><a class="text-link" href={withBase('/showcase/')}>Visit the showcase</a>
        </div>
      </div>
      <div class="showcase-preview-grid">
        {
          showcase.map((entry, index) => (
            <a
              class={`showcase-preview accent-${entry.data.accent} item-${index + 1}`}
              href={withBase(`/showcase/${entrySlug(entry.id)}/`)}
            >
              <div class="showcase-art" aria-hidden="true">
                <>
                  <span />
                  <i />
                  <b>{String(index + 1).padStart(2, '0')}</b>
                </>
              </div>
              <>
                <small>{entry.data.creator}</small>
                <h3>{entry.data.title}</h3>
                <p>{entry.data.summary}</p>
                <span class="view-label">Open archive <span set:html={ArrowRight}></span></span>
              </>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="final-cta dark-panel">
    <div class="content-shell">
      <span class="eyebrow">Free · Open source · Local-first</span>
      <h2>Build your archive. <em class="accent-italic">Keep it yours.</em></h2>
      <p>
        Daena Archive is free and open source. Download the alpha, explore the source, or help shape
        what comes next.
      </p>
      <div class="button-row">
        <a class="button button-brass" href={withBase('/download/')}>Download Daena</a><a
          class="button button-secondary"
          href={siteConfig.repository}>View on GitHub <span set:html={ArrowUpRight}></span></a
        ><a class="text-link" href={withBase('/docs/')}>Read the documentation</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: min(57rem, calc(100vh - var(--header-height)));
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: #f6f0e4;
    color: #34352f;
  }
  .hero-art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hero-art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .hero-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(248, 246, 239, 0.98) 0%,
      rgba(248, 246, 239, 0.91) 31%,
      rgba(248, 246, 239, 0.15) 61%,
      rgba(248, 246, 239, 0.02) 100%
    );
  }
  .hero-inner {
    position: relative;
    flex: 1;
    display: flex;
    align-items: center;
  }
  .hero-copy {
    position: relative;
    z-index: 4;
    width: min(43rem, 52%);
    padding: 5rem 0 3rem 3rem;
  }
  .hero-copy .display-heading {
    color: #253128;
    max-width: none;
    font-weight: 400;
    font-size: clamp(2.8rem, 6vw, 6.4rem);
  }
  .hero-copy .accent-italic {
    font-weight: 300;
  }
  .hero-copy .lede {
    max-width: 34rem;
    color: #4e5049;
  }
  .hero-orbit {
    position: absolute;
    top: 50%;
    right: 25%;
    width: 28rem;
    height: 28rem;
    transform: translate(20%, -50%);
    pointer-events: none;
  }
  .orbit-ring {
    position: absolute;
    inset: 0;
    border: 1px dashed rgba(151, 103, 51, 0.45);
    border-radius: 50%;
  }
  .orbit-ring-2 {
    inset: 3rem;
    border-color: rgba(151, 103, 51, 0.3);
  }
  :global(.hero-archive-card) {
    position: absolute;
    z-index: 5;
    top: 36%;
    right: 6%;
  }
  .map-marker {
    position: absolute;
    z-index: 4;
    display: grid;
    place-items: center;
  }
  .map-marker span {
    position: relative;
    z-index: 1;
    width: 3.2rem;
    height: 3.2rem;
    display: grid;
    place-items: center;
    border: 5px solid rgba(255, 254, 250, 0.85);
    border-radius: 50%;
    background: #2c493a;
    color: #fff;
    box-shadow: 0 8px 20px rgba(30, 45, 37, 0.22);
  }
  .map-marker span :global(svg) {
    width: 1.15rem;
    height: 1.15rem;
  }
  .map-marker i {
    position: absolute;
    width: 7.5rem;
    height: 7.5rem;
    border: 1px dashed rgba(151, 103, 51, 0.5);
    border-radius: 50%;
  }
  .marker-crown {
    top: 18%;
    right: 18%;
  }
  .marker-crown span {
    background: #2c493a;
  }
  .marker-people {
    top: 30%;
    right: 30%;
  }
  .marker-people span {
    background: #a0713c;
  }
  .marker-people i {
    border-color: rgba(160, 113, 60, 0.4);
  }
  .marker-quill {
    top: 42%;
    right: 42%;
  }
  .marker-quill span {
    background: #f0ebe0;
    color: #3a3630;
    border-color: rgba(255, 254, 250, 0.95);
  }
  .marker-sword {
    top: 56%;
    right: 36%;
  }
  .marker-sword span {
    background: #fffefa;
    color: #3a3630;
    width: 2.4rem;
    height: 2.4rem;
    border-width: 4px;
  }
  .marker-sword span :global(svg) {
    width: 0.9rem;
    height: 0.9rem;
  }
  .marker-tree {
    bottom: 24%;
    right: 35%;
  }
  .marker-tree span {
    background: #2c493a;
  }
  .hero-facts {
    position: relative;
    z-index: 4;
    min-height: 6.5rem;
    width: max(42rem, 52%);
    margin-inline: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    align-items: center;
    border-top: 1px solid rgba(125, 113, 91, 0.18);
  }
  .hero-facts div {
    padding-inline: 1.2rem;
    display: grid;
    justify-items: center;
    border-right: 1px solid rgba(125, 113, 91, 0.18);
    color: #34352f;
  }
  .hero-facts div:last-child {
    border-right: 0;
  }
  .hero-facts strong {
    font: 520 1rem/1.15 var(--font-serif);
  }
  .hero-facts span {
    margin-top: 0.15rem;
    color: #646159;
    font-size: 0.65rem;
    letter-spacing: 0.02em;
  }
  :global([data-theme='dark']) .hero {
    background: #0e1714;
  }
  :global([data-theme='dark']) .hero-art {
    opacity: 0.62;
  }
  :global([data-theme='dark']) .hero-shade {
    background: linear-gradient(
      90deg,
      #0e1714 0%,
      rgba(14, 23, 20, 0.94) 33%,
      rgba(14, 23, 20, 0.38) 66%,
      rgba(14, 23, 20, 0.16)
    );
  }
  :global([data-theme='dark']) .hero-copy .display-heading {
    color: #f2eee4;
  }
  :global([data-theme='dark']) .hero-copy .lede,
  :global([data-theme='dark']) .hero-github {
    color: #c8c0b3;
  }
  :global([data-theme='dark']) .hero-facts {
    border-color: #31443a;
  }
  :global([data-theme='dark']) .hero-facts div {
    border-color: #31443a;
    color: #eee8dc;
  }
  :global([data-theme='dark']) .hero-facts span {
    color: #aaa296;
  }
  .intro-grid {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    gap: clamp(3rem, 8vw, 8rem);
    align-items: end;
  }
  .intro-copy > p {
    font: 400 clamp(0.95rem, 1.4vw, 1.2rem)/1.6 var(--font-serif);
  }
  .thread-list {
    margin-top: 2rem;
    display: grid;
    grid-template-columns: auto 1fr auto 1fr;
    gap: 0.75rem 1.2rem;
    align-items: center;
  }
  .thread-list span {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--muted);
    font-size: 0.75rem;
  }
  .thread-list span :global(svg) {
    width: 0.85rem;
    height: 0.85rem;
    color: var(--copper-text);
  }
  .lore-section {
    padding-top: 3rem;
  }
  .lore-grid {
    display: grid;
    grid-template-columns: 0.72fr 1.28fr;
    gap: clamp(3rem, 7vw, 7rem);
    align-items: center;
  }
  .supporting-line {
    margin: 2rem 0;
    padding-left: 1.2rem;
