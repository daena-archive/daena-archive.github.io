---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { entrySlug, withBase } from '../../config/site';
import { ArrowUpRight } from 'lucide-static';

export async function getStaticPaths() {
  const plugins = await getCollection('plugins');
  return plugins.map((plugin) => ({ params: { slug: entrySlug(plugin.id) }, props: { plugin } }));
}
const { plugin } = Astro.props;
const { Content } = await render(plugin);
---

<BaseLayout title={`${plugin.data.name} plugin`} description={plugin.data.summary}>
  <header class="plugin-detail-hero">
    <div class="plugin-hero-image">
      <Image
        src={plugin.data.image}
        alt=""
        widths={[640, 960, 1536]}
        sizes="(max-width: 55rem) 100vw, 58vw"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </div>
    <div class="plugin-hero-text">
      <nav class="breadcrumb">
        <a href={withBase('/plugins/')}>Plugin registry</a><span>/</span>{plugin.data.package}
      </nav><span class="eyebrow">{plugin.data.categories.join(' · ')}</span><h1
        class="page-heading"
      >
        {plugin.data.name}
      </h1><p class="lede">{plugin.data.summary}</p>
      <div class="plugin-flags">
        {typeof plugin.data.status === 'string' && <StatusBadge status={plugin.data.status} />}
        <span>{plugin.data.official ? 'Official' : 'Community'}</span>
        <span>{plugin.data.bundled ? 'Bundled' : 'Optional'}</span>
      </div>
    </div>
  </header>
  <section class="section-tight">
    <div class="content-shell plugin-detail-grid">
      <aside>
        <h2>Package record</h2><dl>
          <div><dt>Author</dt><dd>{plugin.data.author}</dd></div><div>
            <dt>Version</dt><dd>{plugin.data.version}</dd>
          </div><div><dt>Daena</dt><dd>{plugin.data.daenaCompatibility}</dd></div><div>
            <dt>Host API</dt><dd><code>{plugin.data.hostApi}</code></dd>
          </div><div><dt>Runtime</dt><dd>{plugin.data.runtimeKind}</dd></div><div>
            <dt>Updated</dt><dd>
              {
                plugin.data.updated.toLocaleDateString('en', {
                  dateStyle: 'medium',
                  timeZone: 'UTC',
                })
              }
            </dd>
          </div><div><dt>License</dt><dd>{plugin.data.license}</dd></div>
        </dl>{
          plugin.data.repository && (
            <a class="button button-secondary" href={plugin.data.repository}>
              View source <span set:html={ArrowUpRight}></span>
            </a>
          )
        }
      </aside>
      <div class="content-prose">
        <Content /><h2>Declared capabilities</h2><ul class="capabilities">
          {
            plugin.data.capabilities.map((capability: string) => (
              <li>
                <code>{capability}</code>
              </li>
            ))
          }
        </ul><p class="capability-note">
          These identifiers mirror the current module manifest. The host still validates the active
          session, project, namespace, payload, and current revisions.
        </p>
      </div>
    </div>
  </section>
  <section class="final-cta dark-panel">
    <div class="content-shell">
      <h2>Inspect before you enable.</h2><p>
        Identity, source, compatibility, license, and requested access belong together in every
        registry entry.
      </p><div class="button-row">
        <a class="button button-brass" href={withBase('/plugins/')}>Back to registry</a><a
          class="button button-secondary"
          href={withBase('/docs/plugins/permissions/')}>Understand permissions</a
        >
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .plugin-detail-hero {
    display: grid;
    grid-template-columns: 0.42fr 0.58fr;
    min-height: 28rem;
    border-bottom: 1px solid var(--line);
  }
  .plugin-hero-image {
    order: 1;
    position: relative;
    overflow: hidden;
    background: var(--paper-warm);
  }
  .plugin-hero-text {
    order: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(2rem, 5vw, 4rem) clamp(2rem, 5vw, 4rem) clamp(2rem, 5vw, 4rem) clamp(3rem, 6vw, 6rem);
    background: var(--paper-warm);
  }
  .plugin-hero-image::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, transparent 70%, var(--paper-warm) 100%);
    pointer-events: none;
  }
  .plugin-hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .plugin-flags {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
  }
  .plugin-flags > span {
    padding: 0.4rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.68rem;
  }
  .plugin-detail-grid {
    display: grid;
    grid-template-columns: 0.65fr 1.35fr;
    gap: clamp(3rem, 8vw, 8rem);
    align-items: start;
  }
  aside {
    position: sticky;
    top: calc(var(--header-height) + 2rem);
    padding: 1.4rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--paper-raised);
  }
  aside h2 {
    font-size: 1.5rem;
  }
  aside dl {
    margin: 1rem 0;
  }
  aside dl div {
    padding: 0.65rem 0;
    display: grid;
    grid-template-columns: 6rem 1fr;
    border-bottom: 1px solid var(--line-soft);
    font-size: 0.74rem;
  }
  aside dt {
    color: var(--muted);
  }
  aside dd {
    color: var(--ink);
    overflow-wrap: anywhere;
  }
  .capabilities {
    padding: 0 !important;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
  }
  .capabilities li {
    min-width: 0;
    max-width: 100%;
    margin: 0;
  }
  .capabilities code {
    overflow-wrap: anywhere;
  }
  .capability-note {
    padding: 1rem;
    border-left: 2px solid var(--brass);
    background: var(--paper-warm);
    font-size: 0.85rem;
  }
  .final-cta .button-secondary {
    border-color: #45584d;
    background: transparent;
    color: #f2eee4;
  }
  @media (max-width: 68rem) {
    .plugin-detail-hero {
      grid-template-columns: 0.9fr 1.1fr;
      min-height: 24rem;
    }
    .plugin-hero-text {
      padding: clamp(2rem, 4vw, 3rem) clamp(1.5rem, 3vw, 2.5rem) clamp(2rem, 4vw, 3rem)
        clamp(2rem, 4vw, 3.5rem);
    }
  }
  @media (max-width: 55rem) {
    .plugin-detail-hero {
      grid-template-columns: 1fr;
      min-height: auto;
    }
    .plugin-hero-image {
      order: 0;
      aspect-ratio: 16 / 9;
      min-height: 16rem;
      max-height: 28rem;
    }
    .plugin-hero-image::after {
      background: radial-gradient(ellipse at center, transparent 65%, var(--paper) 100%);
      opacity: 0.35;
    }
    .plugin-hero-text {
      order: 1;
      padding: 2rem 1.5rem 2.2rem;
    }
    .plugin-detail-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    aside {
      position: static;
    }
  }
  @media (max-width: 38rem) {
    .plugin-hero-image {
      aspect-ratio: 3 / 2;
      min-height: 13rem;
    }
    .plugin-hero-text {
      padding: 1.6rem 1.25rem 1.8rem;
    }
    .plugin-hero-text .page-heading {
      font-size: clamp(2.2rem, 9vw, 3rem);
    }
    .plugin-hero-text .lede {
      font-size: 0.98rem;
    }
    .plugin-detail-grid {
      gap: 1.5rem;
    }
    aside {
      padding: 1.1rem;
    }
    aside dl div {
      grid-template-columns: 5.2rem 1fr;
      font-size: 0.7rem;
    }
  }
  @media (max-width: 22rem) {
    .plugin-hero-text {
      padding-inline: 1rem;
    }
  }
</style>
