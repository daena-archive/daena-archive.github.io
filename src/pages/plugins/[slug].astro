---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { moduleIcon } from '../../config/icons';
import { entrySlug, withBase } from '../../config/site';
import { ArrowUpRight } from 'lucide-static';

export async function getStaticPaths() {
  const plugins = await getCollection('plugins');
  return plugins.map((plugin) => ({ params: { slug: entrySlug(plugin.id) }, props: { plugin } }));
}
const { plugin } = Astro.props;
const { Content } = await render(plugin);
---

<BaseLayout title={`${plugin.data.name} plugin`} description={plugin.data.summary}>
  <div class="content-shell plugin-layout">
    <div class="plugin-main">
      <header class="plugin-head">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href={withBase('/plugins/')}>Plugin registry</a><span aria-hidden="true">/</span>{
            plugin.data.package
          }
        </nav>
        <span class="overline">
          <span class="plugin-icon" aria-hidden="true" set:html={moduleIcon(plugin.data.package)} />
          {plugin.data.categories.join(' · ')}
        </span>
        <h1 class="page-heading">{plugin.data.name}</h1>
        <p class="lede">{plugin.data.summary}</p>
      </header>

      <div class="content-prose plugin-prose">
        <Content />
      </div>

      <section class="panel plugin-cta" aria-labelledby="inspect-heading">
        <h2 id="inspect-heading">Inspect before you enable.</h2>
        <p>
          Identity, source, compatibility, license, and requested access belong together in every
          registry entry.
        </p>
        <div class="cta-row">
          <a class="btn btn--primary" href={withBase('/plugins/')}>Back to registry</a>
          <a class="btn btn--quiet" href={withBase('/docs/plugins/permissions/')}
            >Understand permissions</a
          >
        </div>
      </section>
    </div>

    <aside class="panel manifest" aria-labelledby="manifest-heading">
      <div class="panel__header">
        <h2 id="manifest-heading" class="panel__title">Manifest</h2>
      </div>
      <ul class="panel__rows">
        <li><small>Package id</small><code>{plugin.data.package}</code></li>
        <li><small>Version</small><code>{plugin.data.version}</code></li>
        <li><small>Daena</small><span>{plugin.data.daenaCompatibility}</span></li>
        <li><small>Host API</small><code>{plugin.data.hostApi}</code></li>
        <li><small>Runtime</small><span>{plugin.data.runtimeKind}</span></li>
        <li><small>Publisher</small><span>{plugin.data.author}</span></li>
        <li><small>License</small><span>{plugin.data.license}</span></li>
        {
          typeof plugin.data.status === 'string' && (
            <li>
              <small>Status</small>
              <StatusBadge status={plugin.data.status} />
            </li>
          )
        }
        <li>
          <small>Distribution</small><span>{plugin.data.bundled ? 'Bundled' : 'Optional'}</span>
        </li>
        <li><small>Origin</small><span>{plugin.data.official ? 'Official' : 'Community'}</span></li>
        <li>
          <small>Updated</small>
          <span>
            {
              plugin.data.updated.toLocaleDateString('en', {
                dateStyle: 'medium',
                timeZone: 'UTC',
              })
            }
          </span>
        </li>
      </ul>

      <div class="manifest-caps">
        <h3 class="overline overline--quiet">Declared capabilities</h3>
        <ul>
          {
            plugin.data.capabilities.map((capability: string) => (
              <li>
                <code>{capability}</code>
              </li>
            ))
          }
        </ul>
        <p>
          These identifiers mirror the current module manifest. The host still validates the active
          session, project, namespace, payload, and current revisions.
        </p>
      </div>

      {
        plugin.data.repository && (
          <div class="manifest-source">
            <a class="btn btn--quiet" href={plugin.data.repository}>
              View source <span aria-hidden="true" set:html={ArrowUpRight} />
            </a>
          </div>
        )
      }
    </aside>
  </div>
</BaseLayout>

<style>
  .plugin-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: var(--space-7);
    align-items: start;
    padding-block: var(--space-6) var(--space-9);
  }
  .plugin-main {
    min-width: 0;
  }
  .plugin-head {
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--line);
  }
  .breadcrumb {
    margin-bottom: var(--space-4);
    font: 500 12px/1.3 var(--font-ui);
  }
  .plugin-icon {
    display: inline-flex;
    margin-right: var(--space-1);
    vertical-align: -0.2em;
    color: var(--accent-text);
  }
  .plugin-icon :global(svg) {
    width: 14px;
    height: 14px;
  }
  .plugin-prose {
    max-width: var(--measure);
    padding-top: var(--space-5);
  }
  .plugin-cta {
    max-width: var(--measure);
    margin-top: var(--space-7);
    padding: var(--space-5);
  }
  .plugin-cta h2 {
    font-size: 18px;
    line-height: 1.3;
  }
  .plugin-cta p {
    margin-top: var(--space-1);
    color: var(--ink-soft);
    font: 400 14px/1.5 var(--font-ui);
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }
  .manifest {
    position: sticky;
    top: calc(var(--header-height) + var(--space-4));
    padding-bottom: var(--space-4);
  }
  .manifest .panel__header {
    padding-bottom: var(--space-2);
  }
  .manifest .panel__title {
    margin-top: 0;
  }
  .manifest .panel__rows li {
    align-items: baseline;
    padding-block: var(--space-2);
    text-align: right;
    overflow-wrap: anywhere;
  }
  .manifest .panel__rows li > small {
    flex: none;
    text-align: left;
  }
  .manifest .panel__rows li :global(.badge) {
    align-self: center;
  }
  .manifest code,
  .manifest-caps code {
    padding: 1px 6px;
    border: 1px solid var(--line-soft);
    border-radius: var(--radius-xs);
    background: var(--surface-muted);
    color: var(--ink);
    font: 12px/1.5 var(--font-mono);
    overflow-wrap: anywhere;
  }
  .manifest-caps {
    padding: var(--space-3) var(--space-5) 0;
    border-top: 1px solid var(--line-soft);
  }
  .manifest-caps ul {
    display: grid;
    justify-items: start;
    gap: 6px;
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
  }
  .manifest-caps p {
    margin-top: var(--space-3);
    color: var(--ink-soft);
    font: 400 13px/1.5 var(--font-ui);
  }
  .manifest-source {
    padding: var(--space-4) var(--space-5) 0;
  }
  .manifest-source .btn {
    width: 100%;
  }
  .manifest-source :global(svg) {
    width: 16px;
    height: 16px;
  }
  @media (max-width: 900px) {
    .plugin-layout {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-5);
    }
    .manifest {
      position: static;
    }
  }
</style>
