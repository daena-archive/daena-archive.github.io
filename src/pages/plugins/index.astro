---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { moduleIcon } from '../../config/icons';
import { entrySlug, withBase } from '../../config/site';
import { Info, Search } from 'lucide-static';

const plugins = (await getCollection('plugins')).sort((a, b) =>
  a.data.name.localeCompare(b.data.name),
);
const categories = [...new Set(plugins.flatMap((plugin) => plugin.data.categories))].sort();
---

<BaseLayout
  title="Plugin registry"
  description="Browse Daena's static, permission-aware catalogue of bundled modules and future community extensions."
>
  <header class="page-hero">
    <div class="content-shell">
      <span class="overline">Plugin registry</span>
      <h1 class="page-heading">Extensions, catalogued with their boundaries.</h1>
      <p class="lede">
        Browse the first-party modules shipped with Daena. Every entry exposes identity, version,
        compatibility, status, license, and requested capabilities—without ratings or store
        mechanics.
      </p>
    </div>
  </header>

  <div class="content-shell page-body">
    <div class="notice" role="status">
      <Fragment set:html={Info} />
      <strong>Current catalogue</strong>
      <p>
        The initial registry contains real bundled modules from the Daena repository. Community
        submission and review are planned.
      </p>
    </div>

    <div class="plugin-filters" role="search" data-plugin-filters>
      <div class="search-field">
        <label class="sr-only" for="plugin-search">Search modules</label>
        <span class="search-icon" aria-hidden="true" set:html={Search} />
        <input
          id="plugin-search"
          class="input"
          type="search"
          placeholder="Search modules, packages, or capabilities…"
          data-plugin-search
        />
      </div>
      <label class="sr-only" for="plugin-category">Category</label>
      <select id="plugin-category" class="input" data-plugin-category>
        <option value="all">All categories</option>
        {categories.map((category) => <option value={category}>{category}</option>)}
      </select>
      <label class="sr-only" for="plugin-status">Status</label>
      <select id="plugin-status" class="input" data-plugin-status>
        <option value="all">All statuses</option>
        <option value="beta">Beta</option>
        <option value="experimental">Experimental</option>
      </select>
      <span class="filter-count" aria-live="polite" data-plugin-count>{plugins.length} modules</span
      >
    </div>

    <div class="plugin-grid" data-plugin-grid>
      {
        plugins.map((plugin) => (
          <a
            class="plugin-card panel panel--interactive"
            href={withBase(`/plugins/${entrySlug(plugin.id)}/`)}
            data-plugin-card
            data-name={`${plugin.data.name} ${plugin.data.package} ${plugin.data.summary} ${plugin.data.capabilities.join(' ')}`.toLowerCase()}
            data-categories={plugin.data.categories.join(' ')}
            data-status={plugin.data.status}
          >
            <h2>
              <span
                class="card-icon"
                aria-hidden="true"
                set:html={moduleIcon(plugin.data.package)}
              />
              {plugin.data.name}
            </h2>
            <p class="card-meta">
              {plugin.data.author} · {plugin.data.categories.join(', ')}
            </p>
            <p class="card-summary">{plugin.data.summary}</p>
            <div class="card-foot">
              <code>v{plugin.data.version}</code>
              <code>{plugin.data.hostApi}</code>
              {typeof plugin.data.status === 'string' && (
                <StatusBadge status={plugin.data.status} />
              )}
              <span class="card-caps">
                {plugin.data.capabilities.length}{' '}
                {plugin.data.capabilities.length === 1 ? 'capability' : 'capabilities'}
              </span>
            </div>
          </a>
        ))
      }
    </div>
    <div class="empty-state" data-plugin-empty>No modules match those filters.</div>

    <section class="workflow panel" aria-labelledby="registry-workflow">
      <div>
        <span class="overline">Registry workflow</span>
        <h2 id="registry-workflow">Contribution, review, rebuild.</h2>
      </div>
      <ol>
        <li><span>01</span><p>Author submits validated metadata.</p></li>
        <li><span>02</span><p>Maintainers review identity, source, and compatibility.</p></li>
        <li><span>03</span><p>The static site rebuilds from merged content.</p></li>
      </ol>
    </section>
  </div>
</BaseLayout>

<script is:inline>
  (() => {
    const search = document.querySelector('[data-plugin-search]');
    const category = document.querySelector('[data-plugin-category]');
    const status = document.querySelector('[data-plugin-status]');
    const cards = [...document.querySelectorAll('[data-plugin-card]')];
    const count = document.querySelector('[data-plugin-count]');
    const empty = document.querySelector('[data-plugin-empty]');
    const update = () => {
      const query = search.value.trim().toLowerCase();
      let visible = 0;
      cards.forEach((card) => {
        const matchesSearch = !query || card.dataset.name.includes(query);
        const matchesCategory =
          category.value === 'all' || card.dataset.categories.split(' ').includes(category.value);
        const matchesStatus = status.value === 'all' || card.dataset.status === status.value;
        const show = matchesSearch && matchesCategory && matchesStatus;
        card.hidden = !show;
        if (show) visible += 1;
      });
      count.textContent = `${visible} ${visible === 1 ? 'module' : 'modules'}`;
      empty.style.display = visible === 0 ? 'block' : 'none';
    };
    search?.addEventListener('input', update);
    category?.addEventListener('change', update);
    status?.addEventListener('change', update);
  })();
</script>

<style>
  .page-body {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-5) var(--space-9);
  }
  .notice p {
    margin: 0;
    color: var(--ink-muted);
  }
  .plugin-filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }
  .search-field {
    position: relative;
    flex: 1 1 18rem;
  }
  .search-icon {
    position: absolute;
    top: 50%;
    left: var(--space-3);
    transform: translateY(-50%);
    color: var(--ink-soft);
    pointer-events: none;
  }
  .search-icon :global(svg) {
    width: 16px;
    height: 16px;
  }
  .search-field .input {
    padding-left: 2.25rem;
  }
  .plugin-filters select.input {
    width: auto;
    flex: 0 1 11rem;
  }
  .filter-count {
    margin-left: auto;
    color: var(--ink-soft);
    font: 500 13px/1 var(--font-ui);
    white-space: nowrap;
  }
  .plugin-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
  }
  .plugin-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-4);
    color: inherit;
    text-decoration: none;
  }
  .plugin-card[hidden] {
    display: none;
  }
  .plugin-card h2 {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 18px;
    font-weight: 500;
    line-height: 1.25;
  }
  .card-icon {
    display: inline-flex;
    color: var(--accent);
  }
  .card-icon :global(svg) {
    width: 16px;
    height: 16px;
  }
  .card-meta {
    margin-top: 2px;
    color: var(--ink-soft);
    font: 500 12px/1.4 var(--font-ui);
  }
  .card-summary {
    margin-top: var(--space-2);
    color: var(--ink-soft);
    font: 400 14px/1.5 var(--font-ui);
  }
  .card-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px var(--space-2);
    margin-top: auto;
    padding-top: var(--space-3);
  }
  .card-foot code {
    flex: none;
    padding: 1px 6px;
    border: 1px solid var(--line-soft);
    border-radius: var(--radius-xs);
    background: var(--surface-muted);
    color: var(--ink-muted);
    font: 12px/1.5 var(--font-mono);
  }
  .card-caps {
    margin-left: auto;
    color: var(--ink-soft);
    font: 500 12px/1 var(--font-ui);
  }
  .empty-state {
    padding: var(--space-6);
  }
  .workflow {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: var(--space-6);
    margin-top: var(--space-6);
    padding: var(--space-5);
  }
  .workflow h2 {
    margin-top: var(--space-2);
    font-size: 24px;
    line-height: 1.2;
  }
  .workflow ol {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .workflow li {
    padding-top: var(--space-3);
    border-top: 1px solid var(--line-soft);
  }
  .workflow li span {
    color: var(--accent-text);
    font: 700 12px/1 var(--font-ui);
  }
  .workflow li p {
    margin-top: var(--space-2);
    color: var(--ink-soft);
    font: 400 14px/1.5 var(--font-ui);
  }
  @media (max-width: 60rem) {
    .plugin-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .workflow {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 38rem) {
    .plugin-grid,
    .workflow ol {
      grid-template-columns: minmax(0, 1fr);
    }
    .plugin-filters select.input {
      flex: 1 1 100%;
    }
    .filter-count {
      width: 100%;
      margin-left: 0;
    }
  }
</style>
