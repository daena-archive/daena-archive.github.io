---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig, withBase } from '../config/site';
import { ArrowUpRight, GitFork, MessagesSquare, Puzzle } from 'lucide-static';

const links = [
  {
    icon: GitFork,
    title: 'Contribute to Daena',
    body: 'Read the repository guidance, choose a bounded issue, and keep architectural contracts and user data ownership in view.',
    label: 'Contribution guide',
    href: siteConfig.contributing,
  },
  {
    icon: MessagesSquare,
    title: 'Ask and propose',
    body: 'Use GitHub Discussions for product questions and design directions. Use Issues for reproducible defects and scoped work.',
    label: 'Open discussions',
    href: siteConfig.discussions,
  },
  {
    icon: Puzzle,
    title: 'Prepare a plugin',
    body: 'The third-party platform is experimental. Inspect current manifests, SDK contracts, and capability rules before treating a package as distributable.',
    label: 'Plugin development',
    href: withBase('/docs/developer/plugin-development/'),
  },
  // Hidden until the showcase returns to the navigation.
  // {
  //   icon: GalleryVerticalEnd,
  //   title: 'Prepare a showcase',
  //   body: 'Future entries will be moderated, content-driven project exhibitions—not a social feed. Creator consent, useful context, and accurate attribution come first.',
  //   label: 'See the initial format',
  //   href: withBase('/showcase/'),
  // },
];
---

<BaseLayout
  title="Community"
  description="Contribute to Daena, discuss the project, and understand the planned plugin and showcase submission principles."
>
  <header class="page-hero">
    <div class="content-shell">
      <span class="overline">Community · Contribution</span>
      <h1 class="page-heading">Build worlds together, even when the archives are your own.</h1>
      <p class="lede">
        Daena is local-first, but its source, design decisions, bug reports, plugins, and showcase
        can be shaped in public.
      </p>
    </div>
  </header>

  <div class="content-shell page-body">
    <div class="community-grid">
      {
        links.map((link) => (
          <a class="community-card panel panel--interactive" href={link.href}>
            <span class="card-icon" aria-hidden="true" set:html={link.icon} />
            <h2>{link.title}</h2>
            <p>{link.body}</p>
            <span class="card-link">
              {link.label} <span aria-hidden="true" set:html={ArrowUpRight} />
            </span>
          </a>
        ))
      }
    </div>

    <section class="panel principles" aria-labelledby="principles-heading">
      <div>
        <span class="overline">Participation principles</span>
        <h2 id="principles-heading">Specific, kind, and technically honest.</h2>
      </div>
      <div>
        <ul>
          <li>Do not present roadmap ideas as released behavior.</li>
          <li>Respect project ownership, privacy, and creator attribution.</li>
          <li>Report evidence and reproduction steps rather than vague failure.</li>
          <li>Keep changes bounded enough to review and verify.</li>
        </ul>
        <a class="btn btn--quiet" href={siteConfig.repository}
          >Visit GitHub <span aria-hidden="true" set:html={ArrowUpRight} /></a
        >
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .page-body {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-5) var(--space-9);
  }
  .community-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
  }
  .community-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-4);
    color: inherit;
    text-decoration: none;
  }
  .card-icon {
    display: inline-flex;
    color: var(--accent);
  }
  .card-icon :global(svg) {
    width: 20px;
    height: 20px;
  }
  .community-card h2 {
    margin-top: var(--space-3);
    font-size: 18px;
    font-weight: 500;
    line-height: 1.25;
  }
  .community-card p {
    margin-top: var(--space-1);
    color: var(--ink-soft);
    font: 400 14px/1.5 var(--font-ui);
  }
  .card-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    margin-top: auto;
    padding-top: var(--space-3);
    color: var(--accent-text);
    font: 600 13px/1.3 var(--font-ui);
  }
  .card-link :global(svg) {
    width: 14px;
    height: 14px;
  }
  .principles {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: var(--space-6);
    padding: var(--space-5);
  }
  .principles h2 {
    margin-top: var(--space-2);
    font-size: 24px;
    line-height: 1.2;
  }
  .principles ul {
    margin: 0 0 var(--space-4);
    padding-left: 1.1rem;
    color: var(--ink-muted);
    font: 400 14px/1.5 var(--font-ui);
  }
  .principles li + li {
    margin-top: var(--space-1);
  }
  .principles .btn :global(svg) {
    width: 16px;
    height: 16px;
  }
  @media (max-width: 60rem) {
    .community-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .principles {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-4);
    }
  }
  @media (max-width: 38rem) {
    .community-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
