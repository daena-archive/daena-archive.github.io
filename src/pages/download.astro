305.53.391.876.085.4.154.78.409 1.066.486.527.645.906.636 1.14l.003-.007v.018l-.003-.012c-.015.262-.185.396-.498.595-.63.401-1.746.712-2.457 1.57-.618.737-1.37 1.14-2.036 1.191-.664.053-1.237-.2-1.574-.898l-.005-.003c-.21-.4-.12-1.025.056-1.69.176-.668.428-1.344.463-1.897.037-.714.076-1.335.195-1.814.12-.465.308-.797.641-.984l.045-.022zm-10.814.049h.01c.053 0 .105.005.157.014.376.055.706.333 1.023.752l.91 1.664.003.003c.243.533.754 1.064 1.189 1.637.434.598.77 1.131.729 1.57v.006c-.057.744-.48 1.148-1.125 1.294-.645.135-1.52.002-2.395-.464-.968-.536-2.118-.469-2.857-.602-.369-.066-.61-.2-.723-.4-.11-.2-.113-.602.123-1.23v-.004l.002-.003c.117-.334.03-.752-.027-1.118-.055-.401-.083-.71.043-.94.16-.334.396-.4.69-.533.294-.135.64-.202.915-.47h.002v-.002c.256-.268.445-.601.668-.838.19-.201.38-.336.663-.336zm7.159-9.074c-.435.201-.945.535-1.488.535-.542 0-.97-.267-1.28-.466-.154-.134-.28-.268-.373-.335-.164-.134-.144-.333-.074-.333.109.016.129.134.199.2.096.066.215.2.36.333.292.2.68.467 1.167.467.485 0 1.053-.267 1.398-.466.195-.135.445-.334.648-.467.156-.136.149-.267.279-.267.128.016.034.134-.147.332a8.097 8.097 0 01-.69.468zm-1.082-1.583V5.64c-.006-.02.013-.042.029-.05.074-.043.18-.027.26.004.063 0 .16.067.15.135-.006.049-.085.066-.135.066-.055 0-.092-.043-.141-.068-.052-.018-.146-.008-.163-.065zm-.551 0c-.02.058-.113.049-.166.066-.047.025-.086.068-.14.068-.05 0-.13-.02-.136-.068-.01-.066.088-.133.15-.133.08-.031.184-.047.259-.005.019.009.036.03.03.05v.02h.003z"/></svg>`;

const releaseTag = siteConfig.releaseTag;
const releaseUrl = `${siteConfig.repository}/releases/tag/${releaseTag}`;
const checksumsUrl = `${siteConfig.repository}/releases/tag/${releaseTag}`;

type MatrixRow = {
  id: 'windows' | 'macos' | 'linux';
  label: string;
  sub: string;
  icon: string;
  builds: {
    arch: 'x86_64' | 'aarch64';
    archLabel: string;
    archMeta: string;
    file: string;
    url: string;
  }[];
};

const matrix: MatrixRow[] = [
  {
    id: 'windows',
    label: 'Windows',
    sub: '10 · 11',
    icon: windowsLogo,
    builds: [
      {
        arch: 'x86_64',
        archLabel: 'x64',
        archMeta: 'x86_64 · .zip',
        file: `daena-${releaseTag}-windows-x86_64.zip`,
        url: releaseAssetUrl(`daena-${releaseTag}-windows-x86_64.zip`),
      },
      {
        arch: 'aarch64',
        archLabel: 'ARM64',
        archMeta: 'aarch64 · .zip',
        file: `daena-${releaseTag}-windows-aarch64.zip`,
        url: releaseAssetUrl(`daena-${releaseTag}-windows-aarch64.zip`),
      },
    ],
  },
  {
    id: 'macos',
    label: 'macOS',
    sub: '12+ · Intel & Apple Silicon',
    icon: appleLogo,
    builds: [
      {
        arch: 'x86_64',
        archLabel: 'Intel',
        archMeta: 'x86_64 · .zip',
        file: `daena-${releaseTag}-macos-x86_64.zip`,
        url: releaseAssetUrl(`daena-${releaseTag}-macos-x86_64.zip`),
      },
      {
        arch: 'aarch64',
        archLabel: 'Apple Silicon',
        archMeta: 'aarch64 · .zip',
        file: `daena-${releaseTag}-macos-aarch64.zip`,
        url: releaseAssetUrl(`daena-${releaseTag}-macos-aarch64.zip`),
      },
    ],
  },
  {
    id: 'linux',
    label: 'Linux',
    sub: 'x64 · ARM64',
    icon: linuxLogo,
    builds: [
      {
        arch: 'x86_64',
        archLabel: 'x64',
        archMeta: 'x86_64 · .tar.gz',
        file: `daena-${releaseTag}-linux-x86_64.tar.gz`,
        url: releaseAssetUrl(`daena-${releaseTag}-linux-x86_64.tar.gz`),
      },
      {
        arch: 'aarch64',
        archLabel: 'ARM64',
        archMeta: 'aarch64 · .tar.gz',
        file: `daena-${releaseTag}-linux-aarch64.tar.gz`,
        url: releaseAssetUrl(`daena-${releaseTag}-linux-aarch64.tar.gz`),
      },
    ],
  },
];
---

<BaseLayout
  title="Download"
  description={`Download Daena Archive ${releaseTag} for Windows, macOS, and Linux (x64 and ARM64). Direct links to GitHub Releases assets.`}
>
  <header class="download-hero dark-panel">
    <div class="content-shell download-grid">
      <div>
        <span class="eyebrow">Alpha · {releaseTag}</span>
        <h1 class="page-heading">Download Daena for your platform.</h1>
        <p class="lede">
          Direct links to the same artifacts published on GitHub Releases. Pick your OS and
          architecture below — checksums and release notes stay canonical on GitHub.
        </p>
        <div class="button-row">
          <a class="button button-brass" href="#matrix"
            >Browse downloads <span set:html={Download} /></a
          >
          <a
            class="button button-secondary"
            href={withBase('/docs/getting-started/installing-daena/')}>Installation guide</a
          >
        </div>
        <p class="hero-meta">
          <span set:html={ShieldCheck} /> 6 artifacts · .zip for Windows/macOS · .tar.gz for Linux · <a
            href={checksumsUrl}
            target="_blank"
            rel="noreferrer">checksums on GitHub</a
          >
        </p>
      </div>
      <div class="download-seal" aria-hidden="true">
        <span>α</span><i></i><b>DAENA ARCHIVE · {releaseTag}</b>
      </div>
    </div>
  </header>

  <section class="section-tight matrix-section">
    <div class="content-shell">
      <div class="matrix-header">
        <span class="eyebrow">Direct downloads</span>
        <h2>OS × architecture matrix</h2>
        <p>
          Windows, macOS, and Linux builds for <strong>x86_64</strong> (Intel/AMD 64-bit) and <strong
            >aarch64</strong
          > (ARM64).
        </p>
      </div>

      <div class="detect-banner" data-detect-banner hidden>
        <span class="detect-icon" set:html={Info} />
        <p data-detect-text>Detecting your platform…</p>
        <a class="text-link" href="#matrix">Jump to downloads</a>
      </div>

      <div id="matrix" class="matrix" role="table" aria-label={`Daena ${releaseTag} downloads`}>
        <div class="matrix-head" role="row">
          <span role="columnheader">Operating system</span>
          <span role="columnheader"
            ><span set:html={Cpu} /> x86_64 <small>Intel / AMD · 64-bit</small></span
          >
          <span role="columnheader"
            ><span set:html={Cpu} /> ARM64 <small>aarch64 · Apple Silicon / ARM</small></span
          >
        </div>

        {
          matrix.map((row) => (
            <div class="matrix-row" role="row" data-os={row.id}>
              <div class="os-cell" role="cell">
                <span class="os-icon" aria-hidden="true" set:html={row.icon} />
                <div>
                  <strong>{row.label}</strong>
                  <small>{row.sub}</small>
                </div>
                <span class="recommended-badge" data-recommended-badge hidden>
                  Recommended
                </span>
              </div>

              {row.builds.map((build) => (
                <a
                  class="download-cell"
                  role="cell"
                  href={build.url}
                  target="_blank"
                  rel="noreferrer"
                  data-os-arch={`${row.id}-${build.arch}`}
                  data-download-trigger
                  aria-label={`Download ${row.label} ${build.archLabel} ${build.file}`}
                >
                  <span class="dl-label">
                    <span set:html={Download} /> {row.label} · {build.archLabel}
                  </span>
                  <span class="dl-meta">{build.archMeta}</span>
                  <code class="dl-file">{build.file}</code>
                  <span class="dl-cta">Direct download</span>
                </a>
              ))}
            </div>
          ))
        }
      </div>

      <div class="matrix-foot">
        <div class="foot-card">
          <h3>Not sure which to pick?</h3>
          <ul>
            <li>
              <strong>macOS:</strong> Apple menu → About This Mac — “Chip” shows Intel or Apple (M1/M2/M3/M4
              = <code>aarch64</code>).
            </li>
            <li>
              <strong>Windows:</strong> Settings → System → About → System type — shows 64-bit / ARM.
            </li>
            <li>
              <strong>Linux:</strong> run <code>uname -m</code> — <code>x86_64</code> for Intel/AMD, <code
                >aarch64</code
              > for ARM.
            </li>
          </ul>
          <p class="muted">
            If you pick the wrong architecture the OS will refuse to launch. Just download the other
            file — both links come from the same GitHub release.
          </p>
        </div>
        <div class="foot-actions">
          <a class="button button-primary" href={releaseUrl} target="_blank" rel="noreferrer"
            >Release notes & checksums <span set:html={ExternalLink} /></a
          >
          <a
            class="button button-secondary"
            href={siteConfig.releases}
            target="_blank"
            rel="noreferrer">All releases</a
          >
          <a class="text-link" href={withBase('/docs/getting-started/installing-daena/')}
            >Installation guide</a
          >
        </div>
      </div>

      <div class="mobile-cards" aria-label="Downloads grouped by OS">
        {
          matrix.map((row) => (
            <article class="mobile-os-card" data-os-card={row.id}>
              <header>
                <span class="os-icon" set:html={row.icon} />
                <div>
                  <strong>{row.label}</strong>
                  <small>{row.sub}</small>
                </div>
                <span class="recommended-badge" data-mobile-badge hidden>
                  Recommended
                </span>
              </header>
              <div class="mobile-builds">
                {row.builds.map((build) => (
                  <a
                    class="mobile-download"
                    href={build.url}
                    target="_blank"
                    rel="noreferrer"
                    data-os-arch={`${row.id}-${build.arch}`}
                    data-download-trigger
                    aria-label={`Download ${row.label} ${build.archLabel}`}
                  >
                    <div>
                      <b>
                        {build.archLabel} <small>· {build.arch}</small>
                      </b>
                      <code>{build.file}</code>
                      <span>{row.id === 'linux' ? 'tar.gz' : 'zip'} · direct from GitHub</span>
                    </div>
                    <span class="mobile-cta" aria-hidden="true" set:html={Download} />
                  </a>
                ))}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-tight first-launch-section" id="first-launch">
    <div class="content-shell">
      <span class="eyebrow">First launch</span>
      <h2>Unsigned builds — what to expect</h2>
      <p class="lede first-launch-lede">
        Daena Archive is currently distributed <strong>without a code-signing certificate</strong>,
        so your operating system may warn you when launching it.
      </p>
      <div class="first-launch-grid">
        <article class="surface first-launch-card">
          <div class="first-launch-head">
            <span class="os-icon" aria-hidden="true" set:html={appleLogo} />
            <div>
              <h3>macOS</h3>
              <small>“Apple can’t check app for malicious software”</small>
            </div>
          </div>
          <p>If macOS blocks the application, run the following command in Terminal:</p>
          <div class="code-block">
            <pre><code>sudo xattr -cr "/Applications/Daena Archive.app"</code></pre>
            <button
              class="copy-btn"
              type="button"
              data-copy='sudo xattr -cr "/Applications/Daena Archive.app"'
              aria-label="Copy command">Copy</button
            >
          </div>
          <p class="muted">Then launch Daena Archive normally from Applications.</p>
        </article>
        <article class="surface first-launch-card">
          <div class="first-launch-head">
            <span class="os-icon" aria-hidden="true" set:html={windowsLogo} />
            <div>
              <h3>Windows</h3>
              <small>Microsoft Defender SmartScreen</small>
            </div>
          </div>
          <p>
            Windows may display a <strong>Microsoft Defender SmartScreen</strong> warning because the
            application is not yet code-signed.
          </p>
          <p>
            Click <strong>More info</strong>, then <strong>Run anyway</strong> to launch Daena Archive.
          </p>
          <p class="muted">
            Linux builds are not code-signed either but do not show a system dialog.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="section-tight verify-section">
    <div class="content-shell verify-grid">
      <article>
        <span>01</span><h2>Verify the artifact</h2><p>
          Compare the SHA-256 from the release page before opening. On macOS/Linux run <code
            >shasum -a 256 &lt;file&gt;</code
          >, on Windows use <code>CertUtil -hashfile &lt;file&gt; SHA256</code>.
        </p><a class="text-link" href={checksumsUrl} target="_blank" rel="noreferrer"
          >Open checksums</a
        >
      </article><article>
        <span>02</span><h2>Install & keep a backup</h2><p>
          Unzip (<code>.zip</code>) or extract (<code>tar -xzf *.tar.gz</code>) and move the app to
          your Applications / Program Files folder. Keep a separate backup of projects you care
          about while Daena is in alpha.
        </p><a class="text-link" href={withBase('/docs/getting-started/installing-daena/')}
          >Installation guide</a
        >
      </article><article>
        <span>03</span><h2>Stale links can’t happen</h2><p>
          The website does not re-host files. Every download is a direct <code
            >releases/download/{releaseTag}/</code
          > URL. If this page lags behind a new tag, the <a href={siteConfig.releases}
            >Releases index</a
          > is always newer.
        </p><a class="text-link" href={siteConfig.issues} target="_blank" rel="noreferrer"
          >Report an issue</a
        >
      </article>
    </div>
  </section>

  <section class="release-authority">
    <div class="reading-shell">
      <span class="eyebrow">Current authority</span><h2>
        GitHub Releases is the source of truth.
      </h2><p>
        The matrix above is convenience. The per-release notes, platform requirements, and checksums
        on GitHub are authoritative. If a download fails, open the release directly.
      </p><div class="button-row">
        <a class="button button-primary" href={siteConfig.releases} target="_blank" rel="noreferrer"
          >Open releases <span set:html={ArrowUpRight} /></a
        ><a class="text-link" href={siteConfig.issues} target="_blank" rel="noreferrer"
          >Report an issue</a
        >
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (() => {
    const ua = (navigator.userAgent || '').toLowerCase();
    const platform = (navigator.platform || '').toLowerCase();
    const udPlatform = (
      navigator.userAgentData && navigator.userAgentData.platform
        ? navigator.userAgentData.platform
        : ''
    ).toLowerCase();

    const combined = `${ua} ${platform} ${udPlatform}`;

    let os = null;
    // mac detection first: ua contains "mac" also on iphone, but platform/ud helps
    if (/mac/.test(combined) && !/iphone|ipad|ipod/.test(combined)) os = 'macos';
    else if (/win/.test(combined)) os = 'windows';
    else if (/linux/.test(combined)) os = 'linux';

    // chromium-based may expose architecture via userAgentData (high entropy)
    let arch = null;

    // explicit arch hints in UA/platform
    const hasArm = /aarch64|arm64|\barm\b/.test(combined);
    const hasX64 = /x86_64|amd64|wow64|win64|x64/.test(combined);
    if (hasArm && !hasX64) arch = 'aarch64';
    else if (hasX64 && !hasArm) arch = 'x86_64';
    else arch = null; // unknown -> per-OS default later (macOS=arm, Windows/Linux=x64)

    // Try high entropy for precise arch if available (async)
    async function refineWithHighEntropy() {
      try {
        if (
          navigator.userAgentData &&
          typeof navigator.userAgentData.getHighEntropyValues === 'function'
        ) {
          const hints = await navigator.userAgentData.getHighEntropyValues([
            'architecture',
            'platform',
          ]);
          const hArch = (hints.architecture || '').toLowerCase();
          const hPlat = (hints.platform || '').toLowerCase();
          if (hArch) {
            if (/arm/.test(hArch)) arch = 'aarch64';
            else if (/x86/.test(hArch)) arch = 'x86_64';
          }
          if (hPlat) {
            if (/macos/.test(hPlat)) os = 'macos';
            else if (/windows/.test(hPlat)) os = 'windows';
            else if (/linux/.test(hPlat)) os = 'linux';
          }
          applyHighlight();
        }
      } catch (e) {
        // ignore
      }
    }

    function getDefaultArch(targetOs) {
      return targetOs === 'macos' ? 'aarch64' : 'x86_64';
    }

    function applyHighlight() {
      if (!os) return;
      const banner = document.querySelector('[data-detect-banner]');
      const text = document.querySelector('[data-detect-text]');
      const effectiveArch = arch || getDefaultArch(os);
      if (banner && text) {
        banner.hidden = false;
        const prettyOs = os === 'macos' ? 'macOS' : os === 'windows' ? 'Windows' : 'Linux';
        const prettyArch = effectiveArch === 'aarch64' ? 'ARM64 (aarch64)' : 'x64 (x86_64)';
        const suffix = arch ? '' : ' · default';
        text.innerHTML = `Detected: <strong>${prettyOs}</strong> · ${prettyArch}${suffix} — highlighted.`;
      }

      // Desktop table rows
      document.querySelectorAll('[data-os]').forEach((el) => {
        const isMatch = el.getAttribute('data-os') === os;
        el.classList.toggle('is-recommended', isMatch);
        const badge = el.querySelector('[data-recommended-badge]');
        if (badge) badge.hidden = !isMatch;
      });

      // Mobile cards
      document.querySelectorAll('[data-os-card]').forEach((el) => {
        const isMatch = el.getAttribute('data-os-card') === os;
        el.classList.toggle('is-recommended', isMatch);
        const badge = el.querySelector('[data-mobile-badge]');
        if (badge) badge.hidden = !isMatch;
      });

      // Highlight exact arch cell — use per-OS default (macOS=arm, Windows/Linux=x64) when arch unknown
      const key = `${os}-${effectiveArch}`;
      document.querySelectorAll('[data-os-arch]').forEach((el) => {
        const match = el.getAttribute('data-os-arch') === key;
        el.classList.toggle('is-exact', match);
      });
    }

    applyHighlight();
    refineWithHighEntropy();
  })();
</script>

<script is:inline>
  (() => {
    document.addEventListener('click', async (e) => {
      const btn = e.target.closest('[data-copy]');
      if (!btn) return;
      const text = btn.getAttribute('data-copy');
      if (!text) return;
      try {
        await navigator.clipboard.writeText(text);
        const prev = btn.textContent;
        btn.textContent = 'Copied';
        btn.dataset.copied = 'true';
        setTimeout(() => {
          btn.textContent = prev;
          btn.dataset.copied = 'false';
        }, 1400);
      } catch {}
    });
  })();
</script>

<script is:inline>
  (() => {
    const firstLaunch = document.getElementById('first-launch');
    if (!firstLaunch) return;
    document.addEventListener('click', (e) => {
      const trigger = e.target.closest('[data-download-trigger]');
      if (!trigger) return;
      // download opens in new tab (target=_blank), page stays — guide user to first-launch
      setTimeout(() => {
        firstLaunch.scrollIntoView({ behavior: 'smooth', block: 'start' });
        firstLaunch.classList.add('is-highlighted');
        history.replaceState(null, '', '#first-launch');
        setTimeout(() => firstLaunch.classList.remove('is-highlighted'), 1800);
      }, 350);
    });
  })();
</script>

