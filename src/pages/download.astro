---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig, withBase } from '../config/site';
import { ArrowUpRight, Download, ShieldCheck } from 'lucide-static';

const windowsLogo = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 3h7v7H3V3zm11 0h7v7h-7V3zM3 14h7v7H3v-7zm11 0h7v7h-7v-7z"/></svg>`;
const appleLogo = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701"/></svg>`;
const macCommand = 'sudo xattr -cr "/Applications/Daena Archive.app"';
---

<BaseLayout
  title="Download"
  description="Download Daena Archive for Windows x64 and macOS Apple Silicon from GitHub Releases."
>
  <header class="page-hero">
    <div class="content-shell page-hero-grid">
      <div>
        <span class="eyebrow">{siteConfig.status}</span>
        <h1 class="page-heading">Download Daena Archive.</h1>
        <p class="lede">
          Builds are published on GitHub Releases. This page lists currently supported platforms and
          what to expect on first launch.
        </p>
        <div class="button-row">
          <a class="button button-primary" href={siteConfig.releases} target="_blank" rel="noopener noreferrer"
            >Open GitHub Releases <span aria-hidden="true" set:html={ArrowUpRight}></span></a
          >
          <a class="button button-secondary" href={withBase('/docs/getting-started/installing-daena/')}
            >Installation guide</a
          >
        </div>
      </div>
      <div class="page-hero-aside">
        <p>
          The website does not re-host installers. Pick the asset that matches your OS on the
          release page.
        </p>
      </div>
    </div>
  </header>

  <section class="section-tight">
    <div class="content-shell">
      <span class="eyebrow">Supported platforms</span>
      <h2 class="feature-heading">Windows x64 and macOS Apple Silicon.</h2>
      <div class="platform-grid">
        <article class="surface platform-card">
          <span class="os-icon" aria-hidden="true" set:html={windowsLogo}></span>
          <h3>Windows</h3>
          <p>64-bit Intel/AMD (<code>x86_64</code>). Windows 10 or 11.</p>
        </article>
        <article class="surface platform-card">
          <span class="os-icon" aria-hidden="true" set:html={appleLogo}></span>
          <h3>macOS</h3>
          <p>Apple Silicon (<code>aarch64</code>). macOS 12 or later.</p>
        </article>
      </div>
      <p class="muted note">
        Intel Macs, Windows ARM, and Linux are not published yet. If a GitHub asset is not listed
        for your system, that platform is not supported in this release.
      </p>
    </div>
  </section>

  <section class="section-tight channel-section">
    <div class="content-shell">
      <span class="eyebrow">Release channels</span>
      <h2 class="feature-heading">Alpha is pre-release. Beta is the current channel.</h2>
      <div class="channel-grid">
        <article class="surface">
          <span>Beta</span>
          <h3>Current published builds</h3>
          <p>
            GitHub releases that are <strong>not</strong> marked Pre-release. Use these unless you
            were asked to try something newer. Behavior and project format can still change before
            1.0.
          </p>
        </article>
        <article class="surface">
          <span>Alpha</span>
          <h3>Pre-release snapshots</h3>
          <p>
            GitHub tags marked <strong>Pre-release</strong>. Earlier or experimental builds, more
            likely to break or migrate data. Do not use them for work you cannot restore.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="section-tight first-launch-section" id="first-launch">
    <div class="content-shell">
      <span class="eyebrow">First launch</span>
      <h2 class="feature-heading">Unsigned builds — what to expect</h2>
      <p class="section-copy">
        Daena Archive is currently distributed <strong>without a code-signing certificate</strong>,
        so your operating system may warn you when launching it.
      </p>
      <div class="first-launch-grid">
        <article class="surface first-launch-card">
          <div class="first-launch-head">
            <span class="os-icon" aria-hidden="true" set:html={appleLogo}></span>
            <div>
              <h3>macOS</h3>
              <small>“Apple can’t check app for malicious software”</small>
            </div>
          </div>
          <p>If macOS blocks the application, run the following command in Terminal:</p>
          <div class="code-block">
            <pre><code>{macCommand}</code></pre>
            <button class="copy-btn" type="button" data-copy={macCommand} aria-label="Copy command"
              >Copy</button
            >
          </div>
          <p class="muted">Then launch Daena Archive normally from Applications.</p>
        </article>
        <article class="surface first-launch-card">
          <div class="first-launch-head">
            <span class="os-icon" aria-hidden="true" set:html={windowsLogo}></span>
            <div>
              <h3>Windows</h3>
              <small>Microsoft Defender SmartScreen</small>
            </div>
          </div>
          <p>
            Windows may display a <strong>Microsoft Defender SmartScreen</strong> warning because the
            application is not yet code-signed.
          </p>
          <p>
            Click <strong>More info</strong>, then <strong>Run anyway</strong> to launch Daena Archive.
          </p>
        </article>
      </div>
      <p class="verify-line">
        <span aria-hidden="true" set:html={ShieldCheck}></span>
        Compare the SHA-256 on the GitHub release before opening the archive.
      </p>
    </div>
  </section>

  <section class="final-cta dark-panel">
    <div class="content-shell">
      <span class="eyebrow">GitHub Releases</span>
      <h2>Get the current build.</h2>
      <p>Release notes, checksums, and assets stay on GitHub. Open the latest beta there.</p>
      <div class="button-row">
        <a class="button button-brass" href={siteConfig.releases} target="_blank" rel="noopener noreferrer"
          >Download from GitHub <span aria-hidden="true" set:html={Download}></span></a
        >
        <a class="text-link" href={withBase('/docs/getting-started/installing-daena/')}
          >Installation guide</a
        >
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  document.querySelectorAll('[data-copy]').forEach((button) => {
    button.addEventListener('click', async () => {
      const value = button.getAttribute('data-copy') || '';
      try {
        await navigator.clipboard.writeText(value);
        button.dataset.copied = 'true';
        button.textContent = 'Copied';
        setTimeout(() => {
          button.dataset.copied = 'false';
          button.textContent = 'Copy';
        }, 1600);
      } catch {
        button.textContent = 'Copy failed';
      }
    });
  });
</script>

<style>
  .lede {
    max-width: 36rem;
    margin-top: 1.2rem;
  }
  .button-row {
    margin-top: 1.8rem;
  }
  .platform-grid,
  .channel-grid,
  .first-launch-grid {
    margin-top: 2rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .platform-card,
  .channel-grid article,
  .first-launch-card {
    padding: 1.4rem;
  }
  .os-icon {
    width: 2.2rem;
    height: 2.2rem;
    display: grid;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 0.55rem;
    background: var(--paper-warm);
    color: var(--ink);
  }
  .os-icon :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
  }
  .platform-card h3,
  .channel-grid h3,
  .first-launch-head h3 {
    margin-top: 0.9rem;
    font-size: 1.6rem;
  }
  .platform-card p,
  .channel-grid p,
  .first-launch-card p,
  .note {
    margin-top: 0.7rem;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.6;
  }
  .channel-section {
    background: var(--paper-warm);
  }
  .channel-grid span {
    color: var(--copper-text);
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .channel-grid h3 {
    margin-top: 0.7rem;
  }
  .first-launch-section {
    border-top: 1px solid var(--line);
  }
  .first-launch-head {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }
  .first-launch-head h3 {
    margin-top: 0;
  }
  .first-launch-head small {
    display: block;
    margin-top: 0.15rem;
    color: var(--muted);
    font-size: 0.7rem;
  }
  .first-launch-card p strong {
    color: var(--ink);
  }
  .code-block {
    margin-top: 0.4rem;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 0.6rem;
    padding: 0.7rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: 0.6rem;
    background: var(--paper-warm);
  }
  .code-block pre {
    margin: 0;
    overflow-x: auto;
  }
  .code-block code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.78rem;
    color: var(--ink);
    white-space: nowrap;
  }
  .copy-btn {
    padding: 0.42rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 0.4rem;
    background: var(--paper-raised);
    color: var(--ink);
    font-size: 0.72rem;
    font-weight: 700;
    cursor: pointer;
  }
  .copy-btn:hover,
  .copy-btn[data-copied='true'] {
    border-color: var(--brass);
  }
  .copy-btn[data-copied='true'] {
    background: var(--brass);
    color: #2f2619;
  }
  .verify-line {
    margin-top: 1.6rem;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--muted);
    font-size: 0.82rem;
  }
  .verify-line :global(svg) {
    width: 1rem;
    height: 1rem;
    color: var(--copper-text);
  }
  .final-cta .text-link {
    color: #e4c786;
  }
  @media (max-width: 50rem) {
    .platform-grid,
    .channel-grid,
    .first-launch-grid {
      grid-template-columns: 1fr;
    }
    .code-block {
      grid-template-columns: 1fr;
    }
  }
</style>
