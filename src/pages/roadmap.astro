---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import StatusBadge from '../components/StatusBadge.astro';
import { siteConfig, withBase } from '../config/site';
import { Info } from 'lucide-static';

const items = (await getCollection('roadmap')).sort((a, b) => a.data.order - b.data.order);
const statuses = ['stable', 'beta', 'experimental', 'planned', 'exploring'] as const;
const labels = {
  stable: 'Stable',
  beta: 'Beta',
  experimental: 'Experimental',
  planned: 'Planned',
  exploring: 'Exploring',
};
const descriptions = {
  stable: 'Established product principles and implemented foundations.',
  beta: 'Usable now, with behavior or data formats still able to change.',
  experimental: 'Available to interested beta users with known limitations.',
  planned: 'Committed direction, not presented as released capability.',
  exploring: 'A question under consideration, without an implementation promise.',
};
---

<BaseLayout
  title="Roadmap"
  description="See what is stable, beta, experimental, planned, and still only being explored in Daena Archive."
>
  <header class="page-hero">
    <div class="content-shell">
      <span class="overline">Where Daena is going</span>
      <h1 class="page-heading">Built in public, one layer at a time.</h1>
      <p class="lede">
        Daena grows through practical iterations. This roadmap shows what is established, what is
        being tested, and what remains only a direction.{' '}
        <a class="link" href={siteConfig.issues}>Follow development on GitHub</a>
      </p>
    </div>
  </header>

  <div class="content-shell page-body">
    <div class="roadmap-controls" role="group" aria-label="Filter roadmap">
      <button type="button" class="btn btn--ghost" data-roadmap-filter="all" aria-pressed="true"
        >All</button
      >{
        statuses.map((status) => (
          <button
            type="button"
            class="btn btn--ghost"
            data-roadmap-filter={status}
            aria-pressed="false"
          >
            {labels[status]}
          </button>
        ))
      }<span class="filter-count" aria-live="polite" data-roadmap-count
        >{items.length} directions</span
      >
    </div>

    <div class="roadmap-groups">
      {
        statuses.map((status) => {
          const groupItems = items.filter((item) => item.data.status === status);
          return (
            groupItems.length > 0 && (
              <section class="roadmap-group" data-roadmap-lane data-status={status}>
                <header>
                  <h2 class="overline overline--quiet">
                    {labels[status]} · {groupItems.length}
                  </h2>
                  <p>{descriptions[status]}</p>
                </header>
                <ul class="roadmap-rows">
                  {groupItems.map((item) => (
                    <li data-roadmap-item data-status={status}>
                      <div class="row-text">
                        <h3>{item.data.title}</h3>
                        <p>{item.data.summary}</p>
                      </div>
                      <div class="row-side">
                        <span class="row-area">{item.data.area}</span>
                        <StatusBadge status={status} />
                      </div>
                    </li>
                  ))}
                </ul>
              </section>
            )
          );
        })
      }
      <div class="empty-state" data-roadmap-empty>No roadmap items match this filter.</div>
    </div>

    <aside class="notice roadmap-note" aria-labelledby="no-dates">
      <Fragment set:html={Info} />
      <strong id="no-dates">Direction before deadlines.</strong>
      <p>
        No invented dates. Roadmap groups describe product outcomes, not an issue tracker or a
        promise of delivery dates. Release notes remain the authority for what has actually shipped.{
          ' '
        }
        <a class="link" href={withBase('/download/')}>Read the current release path</a>
      </p>
    </aside>
  </div>
</BaseLayout>

<script is:inline>
  (() => {
    const buttons = [...document.querySelectorAll('[data-roadmap-filter]')];
    const lanes = [...document.querySelectorAll('[data-roadmap-lane]')];
    const count = document.querySelector('[data-roadmap-count]');
    const empty = document.querySelector('[data-roadmap-empty]');
    buttons.forEach((button) =>
      button.addEventListener('click', () => {
        const filter = button.dataset.roadmapFilter;
        buttons.forEach((candidate) => {
          candidate.setAttribute('aria-pressed', String(candidate === button));
        });
        let visible = 0;
        lanes.forEach((lane) => {
          const show = filter === 'all' || lane.dataset.status === filter;
          lane.hidden = !show;
          if (show) visible += lane.querySelectorAll('[data-roadmap-item]').length;
        });
        count.textContent = `${visible} ${visible === 1 ? 'direction' : 'directions'}`;
        empty.style.display = visible === 0 ? 'block' : 'none';
      }),
    );
  })();
</script>

<style>
  .page-body {
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-5) var(--space-9);
  }
  .roadmap-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1);
  }
  .roadmap-controls .btn[aria-pressed='true'] {
    background: var(--accent-bg);
    color: var(--ink);
  }
  .filter-count {
    margin-left: auto;
    color: var(--ink-soft);
    font: 500 13px/1 var(--font-ui);
  }
  .roadmap-groups {
    display: grid;
    gap: var(--space-6);
  }
  .roadmap-group[hidden] {
    display: none;
  }
  .roadmap-group header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-3);
    padding-bottom: var(--space-2);
  }
  .roadmap-group header p {
    color: var(--ink-soft);
    font: 400 13px/1.4 var(--font-ui);
  }
  .roadmap-rows {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }
  .roadmap-rows li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 56px;
    padding-block: var(--space-2);
    border-bottom: 1px solid var(--line-soft);
  }
  .row-text {
    min-width: 0;
  }
  .row-text h3 {
    color: var(--ink);
    font: 600 15px/1.35 var(--font-ui);
  }
  .row-text p {
    color: var(--ink-soft);
    font: 400 14px/1.45 var(--font-ui);
  }
  .row-side {
    display: flex;
    flex: none;
    align-items: center;
    gap: var(--space-3);
  }
  .row-area {
    color: var(--ink-soft);
    font: 500 12px/1.3 var(--font-ui);
  }
  .empty-state {
    padding: var(--space-6);
  }
  .notice p {
    margin: 0;
    color: var(--ink-muted);
  }
  @media (max-width: 38rem) {
    .roadmap-rows li {
      align-items: flex-start;
      flex-direction: column;
      gap: var(--space-2);
    }
    .filter-count {
      width: 100%;
      margin-left: 0;
    }
  }
</style>
