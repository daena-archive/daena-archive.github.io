---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import StatusBadge from '../components/StatusBadge.astro';
import { siteConfig, withBase } from '../config/site';

const items = (await getCollection('roadmap')).sort((a, b) => a.data.order - b.data.order);
const statuses = ['stable', 'beta', 'experimental', 'planned', 'exploring'] as const;
const labels = {
  stable: 'Stable',
  beta: 'Beta',
  experimental: 'Experimental',
  planned: 'Planned',
  exploring: 'Exploring',
};
const descriptions = {
  stable: 'Established product principles and implemented foundations.',
  beta: 'Usable now, with behavior or data formats still able to change.',
  experimental: 'Available to interested alpha users with known limitations.',
  planned: 'Committed direction, not presented as released capability.',
  exploring: 'A question under consideration, without an implementation promise.',
};
---

<BaseLayout
  title="Roadmap"
  description="See what is stable, beta, experimental, planned, and still only being explored in Daena Archive."
>
  <header class="roadmap-hero page-hero">
    <div class="content-shell page-hero-grid">
      <div>
        <span class="eyebrow">Where Daena is going</span><h1 class="page-heading">
          Built in public, one layer at a time.
        </h1>
      </div><div class="page-hero-aside">
        <p>
          Daena grows through practical iterations. This roadmap shows what is established, what is
          being tested, and what remains only a direction.
        </p><a class="text-link" href={siteConfig.issues}>Follow development on GitHub</a>
      </div>
    </div>
  </header>

  <section class="roadmap-controls">
    <div class="content-shell">
      <div class="filter-bar" role="group" aria-label="Filter roadmap">
        <button type="button" class="active" data-roadmap-filter="all" aria-pressed="true"
          >All</button
        >{
          statuses.map((status) => (
            <button type="button" data-roadmap-filter={status} aria-pressed="false">
              {labels[status]}
            </button>
          ))
        }<span class="filter-count" data-roadmap-count>{items.length} directions</span>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="content-shell roadmap-lanes">
      {
        statuses.map((status, laneIndex) => {
          const laneItems = items.filter((item) => item.data.status === status);
          return (
            laneItems.length > 0 && (
              <section class="roadmap-lane" data-roadmap-lane data-status={status}>
                <>
                  <header>
                    <>
                      <div>
                        <>
                          <span>{String(laneIndex + 1).padStart(2, '0')}</span>
                          <h2>{labels[status]}</h2>
                        </>
                      </div>
                      <p>{descriptions[status]}</p>
                    </>
                  </header>
                  <div class="lane-items">
                    {laneItems.map((item) => (
                      <article data-roadmap-item data-status={status}>
                        <div>
                          <StatusBadge status={status} />
                          <span>{item.data.area}</span>
                        </div>
                        <h3>{item.data.title}</h3>
                        <p>{item.data.summary}</p>
                        {item.body && <small>Direction note available in source content</small>}
                      </article>
                    ))}
                  </div>
                </>
              </section>
            )
          );
        })
      }
      <div class="empty-state" data-roadmap-empty>No roadmap items match this filter.</div>
    </div>
  </section>

  <section class="roadmap-note dark-panel">
    <div class="reading-shell">
      <span class="eyebrow">No invented dates</span><h2>Direction before deadlines.</h2><p>
        Roadmap lanes describe product outcomes, not an issue tracker or a promise of delivery
        dates. Release notes remain the authority for what has actually shipped.
      </p><a class="button button-brass" href={withBase('/download/')}
        >Read the current release path</a
      >
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (() => {
    const buttons = [...document.querySelectorAll('[data-roadmap-filter]')];
    const lanes = [...document.querySelectorAll('[data-roadmap-lane]')];
    const count = document.querySelector('[data-roadmap-count]');
    const empty = document.querySelector('[data-roadmap-empty]');
    buttons.forEach((button) =>
      button.addEventListener('click', () => {
        const filter = button.dataset.roadmapFilter;
        buttons.forEach((candidate) => {
          candidate.classList.toggle('active', candidate === button);
          candidate.setAttribute('aria-pressed', String(candidate === button));
        });
        let visible = 0;
        lanes.forEach((lane) => {
          const show = filter === 'all' || lane.dataset.status === filter;
          lane.hidden = !show;
          if (show) visible += lane.querySelectorAll('[data-roadmap-item]').length;
        });
        count.textContent = `${visible} ${visible === 1 ? 'direction' : 'directions'}`;
        empty.style.display = visible === 0 ? 'block' : 'none';
      }),
    );
  })();
</script>

<style>
  .page-hero-aside .text-link {
    margin-top: 1.2rem;
  }
  .roadmap-controls {
    position: sticky;
    z-index: 10;
    top: var(--header-height);
    padding-top: 1rem;
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: blur(10px);
  }
  .roadmap-controls .filter-bar {
    margin-bottom: 0;
  }
  .filter-bar button {
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    font-size: 0.72rem;
    cursor: pointer;
  }
  .filter-bar button.active {
    border-color: var(--forest-900);
    background: var(--forest-900);
    color: var(--paper);
  }
  .roadmap-lane {
    display: grid;
    grid-template-columns: 0.6fr 1.4fr;
    gap: 4rem;
    padding: 3.5rem 0;
    border-bottom: 1px solid var(--line);
  }
  .roadmap-lane[hidden] {
    display: none;
  }
  .roadmap-lane > header > div {
    display: flex;
    align-items: baseline;
    gap: 1rem;
  }
  .roadmap-lane header span {
    color: var(--copper-text);
    font: italic 1rem var(--font-serif);
  }
  .roadmap-lane h2 {
    font-size: 3.2rem;
  }
  .roadmap-lane header > p {
    max-width: 22rem;
    margin-top: 0.8rem;
    color: var(--muted);
    font-size: 0.82rem;
  }
  .lane-items {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  .lane-items article {
    padding: 1.3rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--paper-raised);
  }
  .lane-items article > div {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    align-items: center;
  }
  .lane-items article > div > span {
    color: var(--muted);
    font-size: 0.62rem;
    font-weight: 720;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .lane-items h3 {
    margin-top: 1.2rem;
    font-size: 1.6rem;
  }
  .lane-items p {
    margin-top: 0.6rem;
    color: var(--muted);
    font-size: 0.8rem;
  }
  .lane-items small {
    margin-top: 1rem;
    display: block;
    color: var(--muted-light);
    font-size: 0.65rem;
  }
  .roadmap-note {
    padding-block: clamp(5rem, 9vw, 8rem);
  }
  .roadmap-note h2 {
    margin-top: 1rem;
    font-size: 4.3rem;
    line-height: 1;
  }
  .roadmap-note p {
    margin-top: 1.2rem;
    color: #b8b1a5;
  }
  .roadmap-note .button {
    margin-top: 2rem;
  }
  @media (max-width: 54rem) {
    .roadmap-lane {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
    }
    .roadmap-controls {
      position: static;
    }
  }
  @media (max-width: 38rem) {
    .lane-items {
      grid-template-columns: minmax(0, 1fr);
    }
    .roadmap-lane h2 {
      font-size: clamp(2.6rem, 13vw, 3.2rem);
    }
  }
</style>
