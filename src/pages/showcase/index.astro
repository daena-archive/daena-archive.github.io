---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { entrySlug, withBase } from '../../config/site';

const entries = await getCollection('showcase');
---

<BaseLayout
  title="Showcase"
  description="An editorial collection of connected Daena demonstration archives, ready for future moderated community submissions."
>
  <header class="showcase-hero">
    <div class="content-shell">
      <span class="eyebrow">The archive exhibition</span><h1 class="page-heading">
        Every world develops its own shape.
      </h1><p class="lede">
        Explore connected archive studies built around maps, histories, languages, factions, and
        lore. These initial entries are clearly labeled demonstrations—not invented community
        testimonials.
      </p>
    </div>
  </header>

  <section class="showcase-board section-tight">
    <div class="content-shell board-grid">
      {
        entries.map((entry, index) => (
          <a
            class={`board-entry entry-${index + 1} accent-${entry.data.accent}`}
            href={withBase(`/showcase/${entrySlug(entry.id)}/`)}
          >
            <div class="board-art" aria-hidden="true">
              <>
                <span />
                <i />
                <b>{String(index + 1).padStart(2, '0')}</b>
                <em>{entry.data.tags[1] ?? 'archive'}</em>
              </>
            </div>
            <div class="board-copy">
              <>
                <small>{entry.data.creator}</small>
                <h2>{entry.data.title}</h2>
                <p>{entry.data.summary}</p>
                <div>
                  {entry.data.tags.map((tag: string) => (
                    <span>{tag}</span>
                  ))}
                </div>
                <strong>
                  Open archive <i>→</i>
                </strong>
              </>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <section class="community-invite dark-panel">
    <div class="content-shell invite-grid">
      <div>
        <span class="eyebrow">Future collection</span><h2>Share a world when submissions open.</h2>
      </div><div>
        <p>
          Showcase entries are content-driven and will use a moderated contribution workflow. No
          follower counts, engagement feed, or invented community metrics—just projects presented
          with care.
        </p><a class="button button-brass" href={withBase('/community/')}>Submission principles</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .showcase-hero {
    padding-block: clamp(6rem, 12vw, 11rem);
    background: linear-gradient(135deg, var(--paper-warm), var(--paper));
    border-bottom: 1px solid var(--line);
  }
  .showcase-hero .page-heading {
    max-width: 14ch;
  }
  .board-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 1.2rem;
  }
  .board-entry {
    padding: 1rem;
    display: grid;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--paper-raised);
    text-decoration: none;
    transition: transform 180ms ease;
  }
  .board-entry:hover {
    transform: translateY(-3px);
  }
  .board-entry.entry-1 {
    grid-row: span 2;
  }
  .board-entry:not(.entry-1) {
    grid-template-columns: 0.8fr 1.2fr;
    gap: 1.2rem;
  }
  .board-art {
    position: relative;
    min-height: 18rem;
    border-radius: 0.65rem;
    background: linear-gradient(150deg, #a9c4c0, #365d5b);
    overflow: hidden;
  }
  .entry-1 .board-art {
    min-height: 34rem;
  }
  .accent-marsh .board-art {
    background: linear-gradient(145deg, #c5bf96, #566a52);
  }
  .accent-ember .board-art {
    background: linear-gradient(145deg, #d5b59a, #78503f);
  }
  .board-art span {
    position: absolute;
    width: 24rem;
    height: 24rem;
    right: -8rem;
    bottom: -8rem;
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 40% 60% 52% 48%;
  }
  .board-art i {
    position: absolute;
    width: 9rem;
    height: 9rem;
    top: 2rem;
    left: 2rem;
    border: 1px dashed rgba(255, 255, 255, 0.5);
    border-radius: 50%;
  }
  .board-art b {
    position: absolute;
    right: 1rem;
    bottom: 0.7rem;
    color: rgba(255, 255, 255, 0.75);
    font: italic 3.5rem var(--font-serif);
  }
  .board-art em {
    position: absolute;
    top: 1rem;
    right: 1rem;
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.58rem;
    font-style: normal;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  .board-copy {
    padding: 1rem 0.4rem 0.4rem;
  }
  .board-copy small {
    color: var(--copper-text);
    font-size: 0.62rem;
    font-weight: 760;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .board-copy h2 {
    margin-top: 0.65rem;
    font-size: clamp(2rem, 3.5vw, 3.6rem);
    line-height: 0.95;
  }
  .board-copy p {
    margin-top: 1rem;
    color: var(--muted);
    font-size: 0.84rem;
  }
  .board-copy div {
    margin-top: 1.2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .board-copy div span {
    padding: 0.3rem 0.5rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.62rem;
  }
  .board-copy > strong {
    margin-top: 1.5rem;
    display: flex;
    justify-content: space-between;
    color: var(--copper-text);
    font-size: 0.75rem;
  }
  .board-copy > strong i {
    font-style: normal;
  }
  .community-invite {
    padding-block: clamp(5rem, 9vw, 8rem);
  }
  .invite-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
  }
  .invite-grid h2 {
    margin-top: 1rem;
    font-size: 4rem;
    line-height: 1;
  }
  .invite-grid p {
    color: #b8b1a5;
  }
  .invite-grid .button {
    margin-top: 1.8rem;
  }
  @media (max-width: 58rem) {
    .board-grid,
    .invite-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .board-entry.entry-1 {
      grid-row: auto;
    }
    .entry-1 .board-art {
      min-height: 25rem;
    }
  }
  @media (max-width: 38rem) {
    .board-entry:not(.entry-1) {
      grid-template-columns: minmax(0, 1fr);
    }
    .board-art,
    .entry-1 .board-art {
      min-height: 18rem;
    }
    .invite-grid h2 {
      font-size: clamp(2.7rem, 13vw, 4rem);
    }
  }
</style>
