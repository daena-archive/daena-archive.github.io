---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { entrySlug, withBase } from '../../config/site';
import { ArrowRight } from 'lucide-static';

const entries = await getCollection('showcase');
---

<BaseLayout
  title="Showcase"
  description="An editorial collection of connected Daena demonstration archives, ready for future moderated community submissions."
>
  <header class="page-hero">
    <div class="content-shell">
      <span class="overline">The archive exhibition</span>
      <h1 class="page-heading">Every world develops its own shape.</h1>
      <p class="lede">
        Explore connected archive studies built around maps, histories, languages, factions, and
        lore. These initial entries are clearly labeled demonstrations—not invented community
        testimonials.
      </p>
    </div>
  </header>

  <div class="content-shell page-body">
    <div class="board-grid">
      {
        entries.map((entry, index) => (
          <a
            class={`board-entry panel panel--interactive entry-${index + 1} accent-${entry.data.accent}`}
            href={withBase(`/showcase/${entrySlug(entry.id)}/`)}
          >
            <div class="board-art" aria-hidden="true">
              <b>{String(index + 1).padStart(2, '0')}</b>
              <em>{entry.data.tags[1] ?? 'archive'}</em>
            </div>
            <div class="board-copy">
              <span class="badge badge--outline">{entry.data.creator}</span>
              <h2>{entry.data.title}</h2>
              <p>{entry.data.summary}</p>
              <div class="board-tags">
                {entry.data.tags.map((tag: string) => (
                  <span class="badge">{tag}</span>
                ))}
              </div>
              <strong>
                Open archive <i aria-hidden="true" set:html={ArrowRight} />
              </strong>
            </div>
          </a>
        ))
      }
    </div>

    <section class="panel invite" aria-labelledby="invite-heading">
      <div>
        <span class="overline">Future collection</span>
        <h2 id="invite-heading">Share a world when submissions open.</h2>
      </div>
      <div>
        <p>
          Showcase entries are content-driven and will use a moderated contribution workflow. No
          follower counts, engagement feed, or invented community metrics—just projects presented
          with care.
        </p>
        <a class="btn btn--quiet" href={withBase('/community/')}>Submission principles</a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .page-body {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-5) var(--space-9);
  }
  .board-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: var(--space-4);
  }
  .board-entry {
    --art: var(--type-ocean);
    --art-bg: var(--type-ocean-bg);
    display: grid;
    padding: var(--space-4);
    color: inherit;
    text-decoration: none;
  }
  .board-entry.accent-marsh {
    --art: var(--type-moss);
    --art-bg: var(--type-moss-bg);
  }
  .board-entry.accent-ember {
    --art: var(--type-ember);
    --art-bg: var(--type-ember-bg);
  }
  .board-entry.entry-1 {
    grid-row: span 2;
  }
  .board-entry:not(.entry-1) {
    grid-template-columns: 0.8fr 1.2fr;
    gap: var(--space-4);
  }
  .board-art {
    position: relative;
    min-height: 16rem;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--art-bg);
  }
  .entry-1 .board-art {
    min-height: 26rem;
  }
  .board-art b {
    position: absolute;
    right: var(--space-4);
    bottom: var(--space-3);
    color: var(--art);
    font: italic 400 36px/1 var(--font-display);
  }
  .board-art em {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    color: var(--art);
    font: 600 12px/1.3 var(--font-ui);
  }
  .board-copy {
    padding: var(--space-3) var(--space-1) var(--space-1);
  }
  .board-copy h2 {
    margin-top: var(--space-3);
    font-size: 24px;
    line-height: 1.2;
  }
  .board-copy p {
    margin-top: var(--space-2);
    color: var(--ink-soft);
    font: 400 14px/1.5 var(--font-ui);
  }
  .board-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }
  .board-copy > strong {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-4);
    color: var(--accent-text);
    font: 600 13px/1.3 var(--font-ui);
    white-space: nowrap;
  }
  .board-copy > strong i {
    display: inline-flex;
    flex: none;
    font-style: normal;
  }
  .board-copy > strong i :global(svg) {
    width: 16px;
    height: 16px;
  }
  .invite {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
    padding: var(--space-5);
  }
  .invite h2 {
    margin-top: var(--space-2);
    font-size: 24px;
    line-height: 1.2;
  }
  .invite p {
    margin-bottom: var(--space-4);
    color: var(--ink-soft);
    font: 400 14px/1.55 var(--font-ui);
  }
  @media (max-width: 58rem) {
    .board-grid,
    .invite {
      grid-template-columns: minmax(0, 1fr);
    }
    .board-entry.entry-1 {
      grid-row: auto;
    }
    .entry-1 .board-art {
      min-height: 18rem;
    }
  }
  @media (max-width: 38rem) {
    .board-entry:not(.entry-1) {
      grid-template-columns: minmax(0, 1fr);
    }
    .board-art,
    .entry-1 .board-art {
      min-height: 12rem;
    }
  }
</style>
