---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RelationshipGraph from '../../components/RelationshipGraph.astro';
import TimelineStrip from '../../components/TimelineStrip.astro';
import { entrySlug, withBase } from '../../config/site';

export async function getStaticPaths() {
  const entries = await getCollection('showcase');
  return entries.map((entry) => ({ params: { slug: entrySlug(entry.id) }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <header class="page-hero">
    <div class="content-shell">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href={withBase('/showcase/')}>Showcase</a><span aria-hidden="true">/</span>Demonstration
        archive
      </nav>
      <span class="badge badge--outline">{entry.data.creator}</span>
      <h1 class="page-heading">{entry.data.title}</h1>
      <p class="lede">{entry.data.summary}</p>
    </div>
  </header>

  <div class={`content-shell page-body accent-${entry.data.accent}`}>
    <div class="detail-art" aria-hidden="true">
      <em>{entry.data.tags.join(' · ')}</em>
      <b>{entry.data.title}</b>
    </div>

    <section class="statement-grid" aria-label="About this archive">
      <div class="content-prose"><Content /></div>
      <dl>
        {
          entry.data.stats.map((stat: { label: string; value: string }) => (
            <div>
              <dt>{stat.value}</dt>
              <dd>{stat.label}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section aria-labelledby="connections-heading">
      <h2 id="connections-heading" class="overline">Selected connections</h2>
      <p class="section-note">
        A small archive study showing how stable records gather context across modules.
      </p>
      <div class="panel graph-frame"><RelationshipGraph /></div>
    </section>

    <section aria-labelledby="history-heading">
      <span class="overline">History excerpt</span>
      <h2 id="history-heading" class="section-title">Four moments from the same world.</h2>
      <div class="panel timeline-frame">
        <TimelineStrip />
      </div>
    </section>

    <section class="panel detail-cta" aria-labelledby="cta-heading">
      <div>
        <h2 id="cta-heading" class="section-title">Build an archive with your own shape.</h2>
        <p>Daena is free, open source, and local-first.</p>
      </div>
      <div class="cta-row">
        <a class="btn btn--primary" href={withBase('/download/')}>Download Daena</a>
        <a class="btn btn--quiet" href={withBase('/showcase/')}>Back to showcase</a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .page-hero .badge {
    margin-top: var(--space-1);
  }
  .breadcrumb {
    margin-bottom: var(--space-4);
    font: 500 12px/1.3 var(--font-ui);
  }
  .page-body {
    --art: var(--type-ocean);
    --art-bg: var(--type-ocean-bg);
    display: grid;
    gap: var(--space-7);
    padding-block: var(--space-5) var(--space-9);
  }
  .page-body.accent-marsh {
    --art: var(--type-moss);
    --art-bg: var(--type-moss-bg);
  }
  .page-body.accent-ember {
    --art: var(--type-ember);
    --art-bg: var(--type-ember-bg);
  }
  .detail-art {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-5);
    min-height: 14rem;
    padding: var(--space-4) var(--space-5);
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--art-bg);
    color: var(--art);
  }
  .detail-art em {
    font: 600 12px/1.3 var(--font-ui);
    font-style: normal;
  }
  .detail-art b {
    font: italic 400 36px/1.1 var(--font-display);
  }
  .statement-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr);
    gap: var(--space-7);
    align-items: start;
  }
  .statement-grid dl {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--line);
  }
  .statement-grid dl div {
    padding: var(--space-4);
    background: var(--surface);
  }
  .statement-grid dt {
    color: var(--ink);
    font: italic 400 36px/1.1 var(--font-display);
  }
  .statement-grid dd {
    color: var(--ink-soft);
    font: 500 12px/1.4 var(--font-ui);
  }
  .section-title {
    margin-top: var(--space-1);
    font-size: 24px;
    line-height: 1.2;
  }
  .section-note {
    max-width: var(--measure);
    margin-bottom: var(--space-3);
    color: var(--ink-soft);
    font: 400 14px/1.5 var(--font-ui);
  }
  .graph-frame {
    padding: clamp(1rem, 3vw, 1.5rem);
  }
  .timeline-frame {
    margin-top: var(--space-4);
    padding: var(--space-5);
  }
  .detail-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-5);
  }
  .detail-cta p {
    margin-top: var(--space-1);
    color: var(--ink-soft);
    font: 400 14px/1.5 var(--font-ui);
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  @media (max-width: 55rem) {
    .statement-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-5);
    }
  }
</style>
