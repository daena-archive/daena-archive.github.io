---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig, withBase } from '../config/site';
import { ArrowUpRight, ChevronDown } from 'lucide-static';

const entries = (await getCollection('faq')).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(
  entries.map(async (entry) => ({ entry, ...(await render(entry)) })),
);
const categories = [
  ['product', 'About Daena'],
  ['privacy', 'Ownership and privacy'],
  ['workflow', 'Ways of working'],
  ['technical', 'Technical questions'],
] as const;
---

<BaseLayout
  title="Frequently asked questions"
  description="Clear answers about Daena's beta status, ownership model, AI, plugins, Git, and supported workflows."
>
  <header class="page-hero">
    <div class="content-shell">
      <span class="overline">Questions · Answers</span>
      <h1 class="page-heading">What should you know before opening the archive?</h1>
      <p class="lede">
        Short answers are useful. The documentation carries the details and the current release
        notes remain the authority for changing platform and format support.
      </p>
    </div>
  </header>

  <div class="content-shell page-body">
    <div class="faq-column">
      <nav class="faq-jump" aria-label="On this page">
        {categories.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
        <a href={withBase('/docs/')}
          >Documentation <span aria-hidden="true" set:html={ArrowUpRight} /></a
        >
      </nav>

      {
        categories.map(([category, label]) => {
          const questions = rendered.filter(({ entry }) => entry.data.category === category);
          return (
            <section id={category} class="faq-group">
              <span class="overline">{label}</span>
              <div class="faq-list">
                {questions.map(({ entry, Content }) => (
                  <details>
                    <summary>
                      <h2>{entry.data.question}</h2>
                      <span class="faq-chevron" aria-hidden="true" set:html={ChevronDown} />
                    </summary>
                    <div class="faq-answer content-prose">
                      <Content />
                    </div>
                  </details>
                ))}
              </div>
            </section>
          );
        })
      }

      <section class="panel faq-cta" aria-labelledby="faq-cta-heading">
        <h2 id="faq-cta-heading">Still looking for a detail?</h2>
        <p>Read the guides for current behavior or open a project discussion on GitHub.</p>
        <div class="cta-row">
          <a class="btn btn--primary" href={withBase('/docs/')}>Read documentation</a>
          <a class="btn btn--quiet" href={siteConfig.discussions}
            >GitHub discussions <span aria-hidden="true" set:html={ArrowUpRight} /></a
          >
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .page-body {
    padding-block: var(--space-5) var(--space-9);
  }
  .faq-column {
    display: grid;
    gap: var(--space-6);
    max-width: var(--measure);
  }
  .faq-jump {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
  }
  .faq-jump a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--ink-soft);
    font: 500 13px/1.4 var(--font-ui);
    text-decoration: none;
    transition: color 160ms ease;
  }
  .faq-jump a:hover {
    color: var(--ink);
  }
  .faq-jump :global(svg) {
    width: 14px;
    height: 14px;
  }
  .faq-group {
    scroll-margin-top: calc(var(--header-height) + var(--space-4));
  }
  .faq-list {
    margin-top: var(--space-2);
    border-top: 1px solid var(--line);
  }
  .faq-list details {
    border-bottom: 1px solid var(--line);
  }
  .faq-list summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 52px;
    padding-block: var(--space-2);
    cursor: pointer;
    list-style: none;
  }
  .faq-list summary::-webkit-details-marker {
    display: none;
  }
  .faq-list summary h2 {
    color: var(--ink);
    font: 600 16px/1.4 var(--font-ui);
  }
  .faq-chevron {
    display: inline-flex;
    flex: none;
    color: var(--ink-soft);
    transition: transform 160ms ease;
  }
  .faq-chevron :global(svg) {
    width: 16px;
    height: 16px;
  }
  .faq-list details[open] .faq-chevron {
    transform: rotate(180deg);
  }
  .faq-answer {
    padding-bottom: var(--space-4);
    color: var(--ink-muted);
    font: 400 15px/1.6 var(--font-ui);
  }
  .faq-answer :global(p) {
    margin: 0 0 var(--space-3);
  }
  .faq-answer :global(p:last-child) {
    margin-bottom: 0;
  }
  .faq-cta {
    padding: var(--space-5);
  }
  .faq-cta h2 {
    font-size: 18px;
    line-height: 1.3;
  }
  .faq-cta p {
    margin-top: var(--space-1);
    color: var(--ink-soft);
    font: 400 14px/1.5 var(--font-ui);
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }
  .cta-row :global(svg) {
    width: 16px;
    height: 16px;
  }
  @media (prefers-reduced-motion: reduce) {
    .faq-chevron {
      transition: none;
    }
  }
</style>
