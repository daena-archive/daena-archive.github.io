---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { entrySlug, withBase } from '../../config/site';
import { ArrowRight } from 'lucide-static';

const allFeatures = (await getCollection('features')).sort((a, b) => a.data.order - b.data.order);
const groups = [
  [
    'world-model',
    'World model',
    'The records and relationships that give a world durable structure.',
  ],
  ['time', 'Time', 'History, calendars, and the moments that change everything.'],
  ['place', 'Place', 'Geography connected to the archive it describes.'],
  ['language', 'Language', 'Words, sounds, grammar, and the cultures that use them.'],
  ['writing', 'Writing', 'Long-form work with the world close at hand.'],
  ['archive', 'Archive', 'Ownership, search, portability, and project history.'],
  ['extensions', 'Extensions', 'Optional capabilities with explicit boundaries.'],
] as const;
---

<BaseLayout
  title="Features"
  description="Explore the connected modules and capabilities of Daena Archive, with honest maturity labels."
>
  <header class="features-hero dark-panel">
    <div class="shell features-hero-grid">
      <div>
        <span class="eyebrow">The studio</span><h1 class="page-heading">
          A place for every layer of a world.
        </h1><p class="lede">
          Daena is organized around connected modules and capabilities. Use only what your project
          needs, then add more structure as the world grows.
        </p>
      </div>
      <div class="celestial" aria-hidden="true"><i></i><i></i><i></i><span></span></div>
    </div>
  </header>

  <section class="status-key">
    <div class="content-shell">
      <p>Maturity is part of the feature, not a footnote.</p><div>
        <StatusBadge status="stable" /><StatusBadge status="beta" /><StatusBadge
          status="experimental"
        /><StatusBadge status="planned" /><StatusBadge status="exploring" />
      </div>
    </div>
  </section>

  <div class="feature-groups">
    {
      groups.map(([area, title, description], groupIndex) => {
        const features = allFeatures.filter((entry) => entry.data.area === area);
        return (
          features.length > 0 && (
            <section class:list={['feature-group', { alternate: groupIndex % 2 === 1 }]}>
              <div class="content-shell feature-group-grid">
                <header>
                  <>
                    <span>{String(groupIndex + 1).padStart(2, '0')}</span>
                    <h2>{title}</h2>
                    <p>{description}</p>
                  </>
                </header>
                <div class="feature-list">
                  {features.map((feature) => (
                    <a href={withBase(`/features/${entrySlug(feature.id)}/`)} class="feature-row">
                      <span class="feature-index">
                        {String(feature.data.order).padStart(2, '0')}
                      </span>
                      <div>
                        <p>{feature.data.eyebrow}</p>
                        <h3>{feature.data.title}</h3>
                        <span>{feature.data.summary}</span>
                      </div>
                      <StatusBadge status={feature.data.status} />
                      <i aria-hidden="true" set:html={ArrowRight}></i>
                    </a>
                  ))}
                </div>
              </div>
            </section>
          )
        );
      })
    }
  </div>

  <section class="final-cta">
    <div class="content-shell">
      <h2>Start with one thread. Follow where it leads.</h2><p>
        Daena's modules meet in a shared archive, so adding structure never means rebuilding the
        world somewhere else.
      </p><div class="button-row">
        <a class="button button-primary" href={withBase('/download/')}>Download the beta</a><a
          class="button button-secondary"
          href={withBase('/docs/getting-started/your-first-world/')}>Create your first world</a
        >
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .features-hero {
    padding-block: clamp(5rem, 10vw, 9rem);
    overflow: hidden;
  }
  .features-hero-grid {
    display: grid;
    grid-template-columns: 1fr 0.7fr;
    gap: 4rem;
    align-items: center;
  }
  .features-hero .lede {
    color: #b8b1a5;
  }
  .celestial {
    position: relative;
    min-height: 24rem;
    display: grid;
    place-items: center;
  }
  .celestial::before,
  .celestial::after,
  .celestial span {
    position: absolute;
    width: 20rem;
    height: 20rem;
    border: 1px solid #42574b;
    border-radius: 50%;
    content: '';
  }
  .celestial::after {
    width: 13rem;
    height: 13rem;
    border-color: #7d6542;
  }
  .celestial span {
    width: 5.5rem;
    height: 5.5rem;
    border: 0;
    background: radial-gradient(circle at 35% 30%, #e4c786, #9b6e32);
    box-shadow: 0 0 0 1.3rem rgba(217, 165, 82, 0.07);
  }
  .celestial i {
    position: absolute;
    z-index: 2;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: #d9a552;
  }
  .celestial i:nth-child(1) {
    top: 2rem;
    right: 8rem;
  }
  .celestial i:nth-child(2) {
    bottom: 3rem;
    left: 5rem;
  }
  .celestial i:nth-child(3) {
    top: 8rem;
    left: 1rem;
  }
  .status-key {
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--line);
    background: var(--paper-raised);
  }
  .status-key .content-shell {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }
  .status-key p {
    color: var(--muted);
    font: italic 1.1rem var(--font-serif);
  }
  .status-key .content-shell > div {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .feature-group {
    padding-block: clamp(4rem, 8vw, 7rem);
    border-bottom: 1px solid var(--line);
  }
  .feature-group.alternate {
    background: var(--paper-warm);
  }
  .feature-group-grid {
    display: grid;
    grid-template-columns: 0.55fr 1.45fr;
    gap: clamp(3rem, 8vw, 8rem);
  }
  .feature-group header > span {
    color: var(--copper-text);
    font: italic 1.2rem var(--font-serif);
  }
  .feature-group header h2 {
    margin-top: 0.8rem;
    font-size: clamp(3rem, 5vw, 5rem);
    line-height: 0.95;
  }
  .feature-group header p {
    max-width: 19rem;
    margin-top: 1.2rem;
    color: var(--muted);
  }
  .feature-list {
    border-top: 1px solid var(--line);
  }
  .feature-row {
    padding: 1.55rem 0;
    display: grid;
    grid-template-columns: 2.5rem 1fr auto 2rem;
    align-items: center;
    gap: 1rem;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }
  .feature-row:hover h3 {
    color: var(--copper-text);
  }
  .feature-index {
    color: var(--muted-light);
    font-size: 0.65rem;
  }
  .feature-row p {
    color: var(--copper-text);
    font-size: 0.58rem;
    font-weight: 780;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  .feature-row h3 {
    margin-top: 0.3rem;
    font-size: 1.7rem;
    transition: color 180ms ease;
  }
  .feature-row div > span {
    color: var(--muted);
    font-size: 0.82rem;
  }
  .feature-row > i {
    color: var(--copper-text);
    font-style: normal;
    font-size: 1.2rem;
  }
  @media (max-width: 54rem) {
    .features-hero-grid,
    .feature-group-grid {
      grid-template-columns: 1fr;
    }
    .celestial {
      min-height: 17rem;
    }
    .status-key .content-shell {
      align-items: flex-start;
      flex-direction: column;
    }
  }
  @media (max-width: 38rem) {
    .feature-row {
      grid-template-columns: 1fr auto;
    }
    .feature-index,
    .feature-row > i {
      display: none;
    }
    .feature-row div > span {
      display: block;
      margin-top: 0.4rem;
    }
  }
</style>
