---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { entrySlug, withBase } from '../../config/site';
import { ArrowRight } from 'lucide-static';

export async function getStaticPaths() {
  const features = await getCollection('features');
  return features.map((feature) => ({
    params: { slug: entrySlug(feature.id) },
    props: { feature },
  }));
}

const { feature } = Astro.props;
const { Content } = await render(feature);
const allFeatures = await getCollection('features');
const connected = feature.data.connections
  .map((name: string) =>
    allFeatures.find((entry) => entry.data.title === name || entry.data.title.startsWith(name)),
  )
  .filter(Boolean);
---

<BaseLayout title={feature.data.title} description={feature.data.description}>
  <header class="feature-detail-hero">
    <div class="content-shell detail-grid">
      <div>
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href={withBase('/features/')}>Features</a><span>/</span>{
            feature.data.area.replace('-', ' ')
          }
        </nav>
        <span class="eyebrow">{feature.data.eyebrow}</span>
        <h1 class="page-heading">{feature.data.title}</h1>
        <p class="lede">{feature.data.description}</p>
        <div class="detail-actions">
          <StatusBadge status={feature.data.status} />{
            feature.data.docs && (
              <a class="text-link" href={withBase(feature.data.docs)}>
                Read the guide
              </a>
            )
          }
        </div>
      </div>
      <div class={`feature-emblem emblem-${feature.data.icon}`} aria-hidden="true">
        <span>{feature.data.title.charAt(0)}</span><i></i><i></i><b
          >{feature.data.eyebrow.split(' · ')[0]}</b
        >
      </div>
    </div>
  </header>

  <section class="section-tight">
    <div class="content-shell capability-grid">
      <div>
        <span class="eyebrow">What it lets you do</span><h2 class="feature-heading">
          Structure when it helps. Context everywhere.
        </h2>
      </div>
      <ol>
        {
          feature.data.capabilities.map((capability: string, index: number) => (
            <li>
              <>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <p>{capability}</p>
              </>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section-tight detail-body-section">
    <div class="reading-shell content-prose"><Content /></div>
  </section>

  {
    (feature.data.limitation || connected.length > 0) && (
      <section class="section-tight connection-section dark-panel">
        <div class="content-shell connection-grid">
          <div>
            {feature.data.limitation ? (
              <>
                <span class="eyebrow">Current status</span>
                <h2>Know the boundary.</h2>
                <p>{feature.data.limitation}</p>
              </>
            ) : (
              <>
                <span class="eyebrow">Shared archive</span>
                <h2>Built to connect.</h2>
                <p>This capability operates on the same durable records as the rest of Daena.</p>
              </>
            )}
          </div>
          {connected.length > 0 && (
            <div class="connected-list">
              <span>CONNECTED SYSTEMS</span>
              {connected.map((entry: any) => (
                <a href={withBase(`/features/${entrySlug(entry.id)}/`)}>
                  <strong>{entry.data.title}</strong>
                  <small>{entry.data.summary}</small>
                  <i set:html={ArrowRight}></i>
                </a>
              ))}
            </div>
          )}
        </div>
      </section>
    )
  }

  <section class="final-cta">
    <div class="content-shell">
      <h2>Bring this layer into the archive.</h2><p>
        Daena is currently alpha. Start small, keep backups, and follow the release notes as
        workflows mature.
      </p><div class="button-row">
        <a class="button button-primary" href={withBase('/download/')}>Download Daena</a><a
          class="button button-secondary"
          href={withBase('/roadmap/')}>View the roadmap</a
        >
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .feature-detail-hero {
    padding-block: clamp(5rem, 10vw, 9rem);
    background: var(--paper-warm);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }
  .detail-grid {
    display: grid;
    grid-template-columns: 1fr 0.75fr;
    gap: 5rem;
    align-items: center;
  }
  .detail-actions {
    margin-top: 2rem;
    display: flex;
    align-items: center;
    gap: 1.2rem;
  }
  .feature-emblem {
    position: relative;
    min-height: 28rem;
    display: grid;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: var(--radius-large);
    background: var(--paper-raised);
    overflow: hidden;
  }
  .feature-emblem::before,
  .feature-emblem::after {
    position: absolute;
    width: 22rem;
    height: 22rem;
    border: 1px solid var(--line);
    border-radius: 50%;
    content: '';
  }
  .feature-emblem::after {
    width: 12rem;
    height: 12rem;
    border-color: var(--brass);
  }
  .feature-emblem > span {
    position: relative;
    z-index: 2;
    color: var(--forest-900);
    font: italic 8rem/1 var(--font-serif);
  }
  .feature-emblem i {
    position: absolute;
    width: 140%;
    height: 1px;
    background: var(--line);
    transform: rotate(34deg);
  }
  .feature-emblem i:nth-of-type(2) {
    transform: rotate(-34deg);
  }
  .feature-emblem b {
    position: absolute;
    right: 1.5rem;
    bottom: 1.2rem;
    color: var(--copper-text);
    font-size: 0.62rem;
    letter-spacing: 0.15em;
  }
  .emblem-map {
    background: linear-gradient(
      150deg,
      var(--paper-raised),
      color-mix(in srgb, var(--entity-faction) 18%, var(--paper-raised))
    );
  }
  .emblem-language {
    background: linear-gradient(
      150deg,
      var(--paper-raised),
      color-mix(in srgb, var(--brass-soft) 34%, var(--paper-raised))
    );
  }
  .capability-grid {
    display: grid;
    grid-template-columns: 0.75fr 1.25fr;
    gap: clamp(3rem, 7vw, 7rem);
  }
  .capability-grid ol {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }
  .capability-grid li {
    padding: 1.25rem 0;
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 1rem;
    border-bottom: 1px solid var(--line);
  }
  .capability-grid li span {
    color: var(--copper-text);
    font: italic 1rem var(--font-serif);
  }
  .capability-grid li p {
    color: var(--ink);
    font: 520 1.2rem/1.4 var(--font-serif);
  }
  .detail-body-section {
    border-top: 1px solid var(--line);
    background: var(--paper-raised);
  }
  .connection-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 5rem;
  }
  .connection-grid h2 {
    margin-top: 1rem;
    font-size: 3.4rem;
  }
  .connection-grid p {
    max-width: 28rem;
    margin-top: 1.2rem;
    color: #b8b1a5;
  }
  .connected-list > span {
    color: #d5a55f;
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.14em;
  }
  .connected-list a {
    padding: 1rem 0;
    display: grid;
    grid-template-columns: 0.8fr 1.2fr 2rem;
    align-items: center;
    gap: 1rem;
    border-bottom: 1px solid #3b4e44;
    text-decoration: none;
  }
  .connected-list strong {
    color: #f2eee4;
    font: 520 1.15rem var(--font-serif);
  }
  .connected-list small {
    color: #aaa296;
  }
  .connected-list i {
    color: #d5a55f;
    font-style: normal;
  }
  @media (max-width: 55rem) {
    .detail-grid,
    .capability-grid,
    .connection-grid {
      grid-template-columns: 1fr;
    }
    .feature-emblem {
      min-height: 20rem;
    }
  }
</style>
