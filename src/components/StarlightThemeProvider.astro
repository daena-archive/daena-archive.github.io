---
import { Icon } from '@astrojs/starlight/components';
---

<script is:inline>
  window.StarlightThemeProvider = (() => {
    const sharedTheme = localStorage.getItem('daena-theme');
    const legacyTheme = localStorage.getItem('starlight-theme');
    const preference =
      sharedTheme === 'light' || sharedTheme === 'dark' || sharedTheme === 'system'
        ? sharedTheme
        : legacyTheme === 'light' || legacyTheme === 'dark'
          ? legacyTheme
          : 'system';
    const pickerTheme = preference === 'system' ? 'auto' : preference;
    const resolvedTheme =
      preference === 'system'
        ? matchMedia('(prefers-color-scheme: light)').matches
          ? 'light'
          : 'dark'
        : preference;

    localStorage.setItem('daena-theme', preference);
    localStorage.setItem('starlight-theme', preference === 'system' ? '' : preference);
    document.documentElement.dataset.theme = resolvedTheme;

    return {
      updatePickers(theme = pickerTheme) {
        document.querySelectorAll('starlight-theme-select').forEach((picker) => {
          const select = picker.querySelector('select');
          if (select) select.value = theme;
          const template = document.querySelector('#theme-icons');
          const newIcon = template?.content.querySelector(`.${theme}`);
          const oldIcon = picker.querySelector('svg.label-icon');
          if (newIcon && oldIcon) {
            oldIcon.replaceChildren(...newIcon.cloneNode(true).childNodes);
          }
        });
      },
    };
  })();
</script>

<template id="theme-icons">
  <Icon name="sun" class="light" />
  <Icon name="moon" class="dark" />
  <Icon name="laptop" class="auto" />
</template>
