---
import Wordmark from './Wordmark.astro';
import { siteConfig, withBase } from '../config/site';

const columns = [
  {
    title: 'Product',
    links: [
      ['Download', '/download/'],
      // ['Roadmap', '/roadmap/'],
      ['Plugins', '/plugins/'],
    ],
  },
  {
    title: 'Learn',
    links: [
      ['Documentation', '/docs/'],
      ['Getting started', '/docs/getting-started/'],
      ['FAQ', '/faq/'],
    ],
  },
  {
    title: 'Community',
    links: [
      ['GitHub', siteConfig.repository],
      // ['Showcase', '/showcase/'],
      ['Contributing', siteConfig.contributing],
      ['Discussions', siteConfig.discussions],
    ],
  },
  {
    title: 'Project',
    links: [
      ['License', `${siteConfig.repository}/blob/main/LICENSE`],
      ['Releases', siteConfig.releases],
      ['Source', siteConfig.repository],
      // ['Status', '/roadmap/'],
    ],
  },
];
---

<footer class="site-footer">
  <div class="shell footer-grid">
    {
      columns.map((column) => (
        <div class="footer-column">
          <h2 class="overline overline--quiet">{column.title}</h2>
          {column.links.map(([label, href]) => {
            const external = /^https?:/.test(href);
            return (
              <a
                href={withBase(href)}
                target={external ? '_blank' : undefined}
                rel={external ? 'noopener noreferrer' : undefined}
              >
                {label}
              </a>
            );
          })}
        </div>
      ))
    }
  </div>
  <div class="shell footer-bottom">
    <a class="footer-mark" href={withBase('/')} aria-label="Daena Archive home"
      ><Wordmark surface="paper" size={20} /></a
    >
    <p>Built for worlds that deserve to be remembered.</p>
    <p>© {new Date().getFullYear()} Daena Archive contributors.</p>
    <p>{siteConfig.license}</p>
    <p><code>{siteConfig.latestRelease}</code></p>
    <p class="footer-note">Free and open source. No accounts. No subscription tier.</p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-7);
    border-top: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink-soft);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-5);
  }
  .footer-column {
    display: grid;
    align-content: start;
    gap: var(--space-2);
  }
  .footer-column h2 {
    margin: 0 0 var(--space-1);
    font-family: var(--font-ui);
    font-weight: 700;
  }
  .footer-column a {
    width: fit-content;
    color: var(--ink-soft);
    font-size: 13px;
    line-height: 1.5;
    text-decoration: none;
    transition: color 160ms ease;
  }
  .footer-column a:hover {
    color: var(--ink);
  }
  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line-soft);
  }
  .footer-mark {
    display: inline-flex;
  }
  .footer-bottom p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 12px;
    line-height: 1.4;
  }
  .footer-bottom code {
    padding: 2px 6px;
    border-radius: var(--radius-xs);
    background: var(--surface-muted);
    color: var(--ink-muted);
    font: 500 12px/1 var(--font-mono);
  }
  .footer-bottom .footer-note {
    margin-left: auto;
  }
  @media (max-width: 45rem) {
    .site-footer {
      padding-block: var(--space-6);
    }
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-5) var(--space-4);
    }
    .footer-bottom {
      margin-top: var(--space-5);
    }
    .footer-bottom .footer-note {
      margin-left: 0;
      flex-basis: 100%;
    }
  }
</style>
