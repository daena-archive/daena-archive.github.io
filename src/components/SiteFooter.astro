---
import Wordmark from './Wordmark.astro';
import { siteConfig, withBase } from '../config/site';

const columns = [
  {
    title: 'Product',
    links: [
      ['Features', '/features/'],
      ['Download', '/download/'],
      ['Roadmap', '/roadmap/'],
      ['Plugins', '/plugins/'],
    ],
  },
  {
    title: 'Learn',
    links: [
      ['Documentation', '/docs/'],
      ['Getting started', '/docs/getting-started/'],
      ['FAQ', '/faq/'],
    ],
  },
  {
    title: 'Community',
    links: [
      ['GitHub', siteConfig.repository],
      ['Showcase', '/showcase/'],
      ['Contributing', siteConfig.contributing],
      ['Discussions', siteConfig.discussions],
    ],
  },
  {
    title: 'Project',
    links: [
      ['License', `${siteConfig.repository}/blob/main/LICENSE`],
      ['Releases', siteConfig.releases],
      ['Source', siteConfig.repository],
      ['Status', '/roadmap/'],
    ],
  },
];
---

<footer class="site-footer">
  <div class="shell footer-grid">
    <div class="footer-brand">
      <a href={withBase('/')}><Wordmark /></a>
      <p>Built for worlds that deserve to be remembered.</p>
      <span>{siteConfig.status} · {siteConfig.license}</span>
    </div>
    {
      columns.map((column) => (
        <div class="footer-column">
          <h2>{column.title}</h2>
          {column.links.map(([label, href]) => (
            <a href={withBase(href)}>{label}</a>
          ))}
        </div>
      ))
    }
  </div>
  <div class="shell footer-bottom">
    <p>Free and open source. No accounts. No subscription tier.</p>
    <p>© {new Date().getFullYear()} Daena Archive contributors.</p>
  </div>
</footer>

<style>
  .site-footer {
    padding: 5rem 0 2rem;
    background: #17241e;
    color: #d8d1c3;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 2.1fr repeat(4, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
  }
  .footer-brand a {
    text-decoration: none;
    filter: brightness(1.35);
  }
  .footer-brand p {
    max-width: 19rem;
    margin: 1.5rem 0 0.75rem;
    font: italic 1.5rem/1.3 var(--font-serif);
    color: #f2eee4;
  }
  .footer-brand span {
    color: #a49e92;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  h2 {
    margin: 0 0 1.1rem;
    color: #e4c786;
    font: 750 0.7rem/1 var(--font-sans);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .footer-column {
    display: grid;
    align-content: start;
    gap: 0.75rem;
  }
  .footer-column a {
    color: #c7c0b3;
    font-size: 0.84rem;
    text-decoration: none;
  }
  .footer-column a:hover {
    color: #fff;
  }
  .footer-bottom {
    margin-top: 4rem;
    padding-top: 1.5rem;
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    border-top: 1px solid #31443a;
  }
  .footer-bottom p {
    margin: 0;
    color: #938d82;
    font-size: 0.75rem;
  }
  :global(.site-footer .wordmark) {
    color: #f2eee4;
  }
  @media (max-width: 62rem) {
    .footer-grid {
      grid-template-columns: 2fr repeat(2, 1fr);
    }
  }
  @media (max-width: 40rem) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
    .footer-bottom {
      flex-direction: column;
      gap: 0.5rem;
    }
  }
</style>
