---
import {
  BookOpenText,
  CalendarRange,
  Castle,
  Circle,
  Eye,
  EyeOff,
  Hand,
  Hexagon,
  Image as ImageIcon,
  Languages,
  Library,
  Map as MapIcon,
  MousePointer2,
  Pencil,
  Slash,
  UserRound,
} from 'lucide-static';
import { withBase } from '../../config/site';
import ProductFrame from './ProductFrame.astro';
import HousesView from './HousesView.astro';
import LanguageView from './LanguageView.astro';
import LoreView from './LoreView.astro';
import MapCanvas from './MapCanvas.astro';
import TimelineView from './TimelineView.astro';
import WritingView from './WritingView.astro';

// The window is a reduced rendition of the real workspace: each view keeps the
// panes and the controls that say what the section is, and leaves out chrome
// that only matters while working. Order, labels and icons are the real rail's
// (AppSidebar.svelte, workspace-icons.ts, workspace-presentation.ts). Maps
// carries the app's Beta badge. Each tab title starts as the item the window
// opens on (the tree's Mira Vale card, the timeline's War of Tides); the script
// below renames it when another card or bar is picked.
const items = [
  {
    id: 'lore',
    label: 'Lore library',
    title: 'Eldermere · Lore library',
    icon: Library,
    tab: 'Mira Vale',
    tabIcon: UserRound,
  },
  {
    id: 'houses',
    label: 'Houses',
    title: 'Eldermere · Houses',
    icon: Castle,
    tab: 'House Vale',
    tabIcon: Castle,
  },
  {
    id: 'timeline',
    label: 'Timeline',
    title: 'Eldermere · Timeline',
    icon: CalendarRange,
    tab: 'War of Tides',
    tabIcon: CalendarRange,
  },
  {
    id: 'writing',
    label: 'Writing Studio',
    title: 'Eldermere · Writing Studio',
    icon: Pencil,
    tab: 'The Sounding Bell',
    tabIcon: BookOpenText,
  },
  {
    id: 'language',
    label: 'Languages',
    title: 'Eldermere · Languages',
    icon: Languages,
    tab: 'Coastfolk',
    tabIcon: Languages,
  },
  {
    id: 'maps',
    label: 'Maps',
    title: 'Eldermere · Maps',
    icon: MapIcon,
    tab: 'Eldermere',
    tabIcon: MapIcon,
    beta: true,
  },
];
---

<ProductFrame
  name="archive-view"
  groupLabel="Workspace section"
  projectName="Eldermere"
  items={items}
>
  <LoreView slot="view-lore" />
  <p slot="caption-lore">
    Record people, places, cultures, artifacts, and factions, then connect them through structured
    relationships. Structured profiles are optional. Example archive.{' '}
    <a class="link" href={withBase('/docs/lore/creating-entries/')}>Explore Lore</a>
  </p>

  <HousesView slot="view-houses" />
  <p slot="caption-houses">
    Houses and family trees use the same Person records as Lore. Parentage, partnership, and
    membership stay in the archive. Example archive.{' '}
    <a class="link" href={withBase('/docs/houses/houses-and-tree/')}>Explore Houses</a>
  </p>

  <TimelineView slot="view-timeline" />
  <p slot="caption-timeline">
    Build timelines for events, eras, characters, and places. Use calendars when your world needs
    them, or keep dates simple when it does not. Example archive.{' '}
    <a class="link" href={withBase('/docs/timeline/events/')}>Explore Timelines</a>
  </p>

  <WritingView slot="view-writing" />
  <p slot="caption-writing">
    Keep prose close to the people, places, history, and terminology that shape it. The archive is
    never far away when it is time to write. Example archive.{' '}
    <a class="link" href={withBase('/docs/writing/documents/')}>Explore Writing</a>
  </p>

  <LanguageView slot="view-language" />
  <p slot="caption-language">
    Develop sounds, words, grammar, and writing systems alongside the people and places that use
    them. Start with a name and a few notes, or go deeper when the language demands it. Example
    archive.{' '}
    <a class="link" href={withBase('/docs/languages/creating-a-language/')}>Explore Languages</a>
  </p>

  <!-- Maps: an image map in the vector map editor (NativeVectorMapEditor.svelte, MapEditorTools.svelte) -->
  <div slot="view-maps" class="app-screen">
    <header class="app-topbar">
      <div class="app-topbar__brand">
        <span class="app-topbar__mark" set:html={MapIcon} />
        <div class="app-topbar__copy">
          <strong>Vector map</strong>
          <small>Units: pixels</small>
        </div>
      </div>
    </header>
    <div class="app-card maped">
      <nav class="maped__tools">
        <span class="maped__tool" set:html={Hand} />
        <span class="maped__tool is-on" set:html={MousePointer2} />
        <span class="maped__tool" set:html={Circle} />
        <span class="maped__tool" set:html={Slash} />
        <span class="maped__tool" set:html={Hexagon} />
      </nav>
      <aside class="maped__layers">
        <div class="mapl-head">
          <span class="overline">Map layers</span>
          <strong>2 layers · 5 features</strong>
          <small>Units: pixels</small>
        </div>
        <div class="mapl-body">
          <div class="mapl-group">
            <div class="mapl-group__head">Overlays</div>
            <div class="mapl-card is-active" data-layer="political">
              <span class="mapl-card__kind" set:html={Hexagon} />
              <span class="mapl-card__copy"
                ><strong>Political</strong><small>Political · 1 feats</small></span
              >
              <span class="mapl-card__eye" data-toggle-layer="political"
                ><span class="eye-on" set:html={Eye} /><span
                  class="eye-off"
                  set:html={EyeOff}
                /></span
              >
            </div>
            <div class="mapl-card" data-layer="places">
              <span class="mapl-card__kind" set:html={Hexagon} />
              <span class="mapl-card__copy"
                ><strong>Places</strong><small>Custom · 4 feats</small></span
              >
              <span class="mapl-card__eye" data-toggle-layer="places"
                ><span class="eye-on" set:html={Eye} /><span
                  class="eye-off"
                  set:html={EyeOff}
                /></span
              >
            </div>
          </div>
          <div class="mapl-group">
            <div class="mapl-group__head">Rasters</div>
            <div class="mapl-card" data-layer="raster">
              <span class="mapl-card__kind" set:html={ImageIcon} />
              <span class="mapl-card__copy"><strong>eldermere-map.png</strong></span>
              <span class="mapl-card__eye" data-toggle-layer="raster"
                ><span class="eye-on" set:html={Eye} /><span
                  class="eye-off"
                  set:html={EyeOff}
                /></span
              >
            </div>
          </div>
        </div>
      </aside>
      <MapCanvas />
    </div>
  </div>
  <p slot="caption-maps">
    Maps can use your own map image, a GeoJSON vector map, or a generated physical world. Link
    places and entities to geography, and build visual layers on top. Example archive.{' '}
    <a class="link" href={withBase('/docs/maps/overview/')}>Explore Maps</a>
  </p>

  <section slot="overlay" class="entity-hover-card" data-preview-pane hidden>
    <span data-preview-type></span>
    <strong data-preview-name></strong>
    <p data-preview-summary></p>
    <span class="entity-hover-card__open" data-preview-open>Open fully</span>
  </section>
</ProductFrame>

<script is:inline>
  // Progressive enhancement for the app window. The rail and the tab strip
  // already switch workspaces with radios and CSS; this adds the in-window
  // switchers, entity previews, map layer and graph type toggles, and tab
  // titles. No state is stored.
  (() => {
    const figure = document.querySelector('.archive-figure');
    if (!figure) return;
    figure.dataset.enhanced = 'true';

    const pane = figure.querySelector('[data-preview-pane]');
    const previews = {
      'Mira Vale': {
        type: 'Person',
        summary:
          'Cartographer of the Tidewatch. Charts the western soundings for House Vale and keeps the tide tables read on the eastern quay.',
      },
      'Elian Rook': {
        type: 'Person',
        summary: 'Captain of Gull Rock, partner of Mira Vale, and head of House Rook.',
      },
      'Neris Vale': {
        type: 'Person',
        summary: 'Heir of House Vale and its named successor.',
      },
      Eldermere: {
        type: 'Place',
        summary:
          'Harbour city built around the Tidewatch, where the western soundings meet Lantern Marsh.',
      },
      Tidewatch: {
        type: 'Place',
        summary:
          'The old watch and tide archive on Eldermere’s eastern quay. Keeps the western soundings year by year.',
      },
      'Lantern Marsh': {
        type: 'Place',
        summary:
          'Marsh at the western edge of Eldermere, site of the accord that ended the War of Tides.',
      },
      'House Vale': {
        type: 'House',
        summary:
          'Old harbour house seated at Vale Keep. Holds the western soundings, the Tidewatch tables, and the Crown of Salt.',
      },
      'House Rook': {
        type: 'House',
        summary:
          'Captain’s house on Gull Rock, bound to House Vale by marriage and by the War of Tides.',
      },
      Coastfolk: {
        type: 'Culture',
        summary:
          'Tide-reading culture of the western soundings. Keeps histories in sounding tables; its language shares the name.',
      },
      'Crown of Salt': {
        type: 'Artifact',
        summary:
          'Salt-cured silver circlet raised from the soundings. Changed hands in 834 and stays with House Vale.',
      },
      'Marsh Cant': {
        type: 'Language',
        summary:
          'Oral language of the lantern villages. Rarely written; most records are Coastfolk transcriptions.',
      },
      'The Sounding Bell': {
        type: 'Manuscript',
        summary:
          'First manuscript in the Eldermere cycle. It opens at first light on the eastern quay.',
      },
    };

    const openTargets = {
      'Mira Vale': { view: 'lore', group: 'lore-entry', value: 'mira' },
      Eldermere: { view: 'lore', group: 'lore-entry', value: 'eldermere' },
      Coastfolk: { view: 'lore', group: 'lore-entry', value: 'coastfolk' },
      'Crown of Salt': { view: 'lore', group: 'lore-entry', value: 'crown' },
      'House Vale': { view: 'houses', group: 'houses-entry', value: 'vale' },
      'House Rook': { view: 'houses', group: 'houses-entry', value: 'rook' },
      Tidewatch: { view: 'lore', group: 'lore-entry', value: 'tidewatch' },
      'Lantern Marsh': { view: 'lore', group: 'lore-entry', value: 'lantern' },
    };

    const radioName = figure.querySelector('input.rail-radio')?.name || 'archive-view';
    const openLink = pane?.querySelector('[data-preview-open]');
    let currentPreview = '';
    let hideTimer = 0;

    const cancelHide = () => {
      if (hideTimer) window.clearTimeout(hideTimer);
      hideTimer = 0;
    };

    const hidePreview = () => {
      cancelHide();
      if (pane) pane.hidden = true;
    };

    const scheduleHide = () => {
      cancelHide();
      hideTimer = window.setTimeout(() => {
        if (pane) pane.hidden = true;
        hideTimer = 0;
      }, 150);
    };

    const positionPreview = (anchor) => {
      if (!pane) return;
      const bounds = anchor.getBoundingClientRect();
      const width = pane.offsetWidth || 300;
      const height = pane.offsetHeight || 140;
      const left = Math.min(window.innerWidth - width - 12, Math.max(12, bounds.left));
      const top = Math.min(window.innerHeight - height - 12, bounds.bottom + 8);
      pane.style.left = left + 'px';
      pane.style.top = top + 'px';
    };

    const showPreview = (name, anchor) => {
      const preview = previews[name];
      if (!preview || !pane) return;
      cancelHide();
      pane.querySelector('[data-preview-type]').textContent = preview.type;
      pane.querySelector('[data-preview-name]').textContent = name;
      pane.querySelector('[data-preview-summary]').textContent = preview.summary;
      if (openLink) openLink.hidden = !openTargets[name];
      currentPreview = name;
      pane.hidden = false;
      positionPreview(anchor);
    };

    const openCurrent = () => {
      const target = openTargets[currentPreview];
      if (target) {
        const radio = figure.querySelector(
          'input[type="radio"][name="' + radioName + '"][value="' + target.view + '"]',
        );
        if (radio) radio.checked = true;
        const control = figure.querySelector(
          '[data-set="' + target.group + ':' + target.value + '"]',
        );
        if (control) control.click();
      }
      hidePreview();
    };

    figure.querySelectorAll('.ref').forEach((ref) => {
      if (previews[ref.textContent.trim()]) ref.classList.add('is-linked');
    });

    pane?.addEventListener('mouseenter', cancelHide);
    pane?.addEventListener('mouseleave', scheduleHide);

    figure.addEventListener('mouseover', (event) => {
      const ref = event.target.closest('.ref.is-linked');
      if (ref) showPreview(ref.textContent.trim(), ref);
    });

    figure.addEventListener('mouseout', (event) => {
      const ref = event.target.closest('.ref.is-linked');
      if (!ref) return;
      const next = event.relatedTarget;
      if (next instanceof Node && (ref.contains(next) || pane?.contains(next))) return;
      scheduleHide();
    });

    figure.addEventListener('click', (event) => {
      if (event.target.closest('[data-preview-open]')) {
        openCurrent();
        return;
      }

      const ref = event.target.closest('.ref.is-linked');
      if (ref) {
        showPreview(ref.textContent.trim(), ref);
        return;
      }

      const eye = event.target.closest('[data-toggle-layer]');
      if (eye) {
        eye.closest('.mapl-card')?.classList.toggle('is-off');
        return;
      }

      const legend = event.target.closest('[data-toggle-type]');
      if (legend) {
        legend.classList.toggle('is-hidden');
        const hidden = new Set(
          [...figure.querySelectorAll('[data-toggle-type].is-hidden')].map(
            (item) => item.dataset.toggleType,
          ),
        );
        figure.querySelectorAll('[data-types]').forEach((el) => {
          el.classList.toggle(
            'is-cut',
            el.dataset.types.split(' ').some((type) => hidden.has(type)),
          );
        });
        return;
      }

      const target = event.target.closest('[data-set]');
      if (!target || !figure.contains(target)) {
        if (!event.target.closest('[data-preview-pane]')) hidePreview();
        return;
      }

      const [group, value] = target.dataset.set.split(':');
      if (!group || !value) return;
      hidePreview();

      figure.querySelectorAll('[data-set^="' + group + ':"]').forEach((control) => {
        control.classList.toggle('is-active', control.dataset.set === group + ':' + value);
      });
      figure.querySelectorAll('[data-panel^="' + group + ':"]').forEach((panel) => {
        panel.classList.toggle('is-open', panel.dataset.panel === group + ':' + value);
      });

      const title = target.dataset.tabTitle;
      const view = target.closest('.view[data-view]');
      if (title && view) {
        const tabTitle = figure.querySelector(
          '.app-tab[data-view="' + view.dataset.view + '"] .app-tab__title',
        );
        if (tabTitle) tabTitle.textContent = title;
      }
    });

    // The card is fixed to the viewport, so it would drift from its anchor.
    window.addEventListener('scroll', hidePreview, { capture: true, passive: true });
    window.addEventListener('resize', hidePreview);

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') hidePreview();
    });
  })();
</script>

<style>
  /* A framed canvas under a top bar: the map editor. */
  .maped {
    display: grid;
    grid-template-columns: 52px 232px minmax(0, 1fr);
  }
  .maped__tools {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-3) 0;
    background: var(--surface);
  }
  .maped__tool {
    display: grid;
    width: 36px;
    height: 36px;
    place-items: center;
    border-radius: var(--radius-md);
    color: var(--ink-soft);
  }
  .maped__tool.is-on {
    background: var(--success-bg);
    color: var(--success);
  }
  .maped__tool :global(svg) {
    width: 16px;
    height: 16px;
  }
  .maped__layers {
    display: flex;
    min-width: 0;
    min-height: 0;
    flex-direction: column;
    overflow: hidden;
    background: var(--surface-muted);
  }
  .mapl-head {
    padding: var(--space-4);
  }
  .mapl-head strong {
    display: block;
    margin-top: 4px;
    color: var(--ink);
    font: 650 13px/1.3 var(--font-ui);
  }
  .mapl-head small {
    color: var(--ink-soft);
    font: 400 12px/1.3 var(--font-ui);
  }
  .mapl-body {
    min-height: 0;
    overflow: hidden;
    padding: 0 var(--space-3) var(--space-4);
  }
  .mapl-group + .mapl-group {
    margin-top: var(--space-4);
  }
  .mapl-group__head {
    margin: 0 4px var(--space-2);
    color: var(--ink-soft);
    font: 700 11px/1 var(--font-ui);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .mapl-card {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 48px;
    padding: 6px 10px;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface);
  }
  .mapl-card + .mapl-card {
    margin-top: var(--space-2);
  }
  .mapl-card.is-active {
    border-color: var(--accent-soft);
  }
  .mapl-card__kind,
  .mapl-card__eye {
    display: inline-flex;
    color: var(--ink-soft);
  }
  .mapl-card__eye {
    color: var(--ink-faint);
  }
  .mapl-card__eye .eye-off {
    display: none;
  }
  .mapl-card.is-off .mapl-card__eye .eye-on {
    display: none;
  }
  .mapl-card.is-off .mapl-card__eye .eye-off {
    display: inline-flex;
  }
  .mapl-card :global(svg) {
    width: 14px;
    height: 14px;
  }
  .mapl-card__copy {
    display: grid;
    min-width: 0;
    flex: 1;
    gap: 2px;
  }
  .mapl-card__copy strong {
    overflow: hidden;
    color: var(--ink);
    font: 650 13px/1.2 var(--font-ui);
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .mapl-card__copy small {
    color: var(--ink-soft);
    font: 400 12px/1.2 var(--font-ui);
    white-space: nowrap;
  }

  @media (max-width: 70rem) {
    .maped {
      grid-template-columns: 52px 200px minmax(0, 1fr);
    }
  }
  @media (max-width: 52rem) {
    .maped {
      grid-template-columns: 52px minmax(0, 1fr);
    }
    .maped__layers {
      display: none;
    }
  }
</style>
