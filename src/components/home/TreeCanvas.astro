---
import EntityGlyph from './EntityGlyph.astro';

// The family-tree canvas of the Houses tree surface:
//   ../daena/src/lib/houses/TreeCanvas.svelte          (dot background; zoom controls left out)
//   ../daena/src/lib/houses/FamilyPersonNode.svelte    (person card: avatar, name, house, role badge)
//   ../daena/src/lib/houses/FamilyUnionNode.svelte     (union dot with "+" to add a child)
//   ../daena/src/lib/houses/FamilyRelationshipEdge.svelte (halo-ed edges)
// Example people only; coordinates are in a fixed 710 x 330 stage centred in the canvas.
const people = [
  { name: 'Mira Vale', role: 'Head', x: 110, y: 30 },
  { name: 'Elian Rook', role: '', x: 400, y: 30 },
  { name: 'Neris Vale', role: 'Heir', x: 255, y: 220 },
] as const;
---

<div class="tree">
  <svg class="tree__dots" role="presentation" focusable="false">
    <defs>
      <pattern id="tree-dots" width="18" height="18" patternUnits="userSpaceOnUse">
        <circle cx="1" cy="1" r="0.5"></circle>
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#tree-dots)"></rect>
  </svg>
  <div class="tree__stage">
    <svg class="tree__edges" viewBox="0 0 710 330" role="presentation" focusable="false">
      <!-- Partner: double line between Mira Vale and Elian Rook -->
      <g class="edge">
        <line class="halo" x1="310" y1="64" x2="400" y2="64"></line>
        <line class="halo" x1="310" y1="72" x2="400" y2="72"></line>
        <line x1="310" y1="64" x2="400" y2="64"></line>
        <line x1="310" y1="72" x2="400" y2="72"></line>
      </g>
      <!-- Parent: union to child -->
      <g class="edge">
        <line class="halo" x1="355" y1="79" x2="355" y2="220"></line>
        <line x1="355" y1="79" x2="355" y2="220"></line>
      </g>
    </svg>
    <span class="union" aria-hidden="true">+</span>
    {
      people.map((person) => (
        <div class="card" style={`left: ${person.x}px; top: ${person.y}px;`}>
          <span class="card__avatar">
            <EntityGlyph type="person" size={34} />
          </span>
          <span class="card__copy">
            <strong>{person.name}</strong>
            <span class="card__house">House Vale</span>
            {person.role && <em class="card__role">{person.role}</em>}
          </span>
        </div>
      ))
    }
  </div>
</div>

<style>
  .tree {
    position: relative;
    min-height: 0;
    flex: 1;
    overflow: hidden;
    background: color-mix(in srgb, var(--surface) 96%, var(--canvas));
  }
  .tree__dots {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .tree__dots circle {
    fill: color-mix(in srgb, var(--line-strong) 38%, transparent);
  }
  .tree__stage {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 710px;
    height: 330px;
    transform: translate(-50%, -50%);
  }
  .tree__edges {
    position: absolute;
    inset: 0;
    width: 710px;
    height: 330px;
    color: var(--ink-muted);
  }
  .edge line {
    stroke: var(--ink-muted);
    stroke-width: 1.5;
    stroke-linecap: round;
  }
  .edge line.halo {
    stroke: var(--surface);
    stroke-width: 5.2;
    opacity: 0.95;
  }
  .union {
    position: absolute;
    top: 57px;
    left: 344px;
    display: grid;
    width: 22px;
    height: 22px;
    place-items: center;
    border: 1.5px solid var(--line-strong);
    border-radius: 50%;
    background: var(--surface);
    color: var(--ink);
    font: 700 13px/1 var(--font-ui);
  }
  .card {
    position: absolute;
    display: flex;
    width: 200px;
    box-sizing: border-box;
    align-items: center;
    gap: 10px;
    height: 76px;
    padding: 0 12px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }
  .card__avatar {
    display: grid;
    width: 38px;
    height: 38px;
    flex: none;
    place-items: center;
    border: 1px solid var(--line-soft);
    border-radius: 50%;
    background: var(--surface-muted);
  }
  .card__copy {
    display: grid;
    min-width: 0;
    gap: 2px;
  }
  .card__copy strong {
    overflow: hidden;
    color: var(--ink);
    font: 600 13px/1.2 var(--font-ui);
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .card__house {
    color: var(--accent-dark);
    font: 700 12px/1.25 var(--font-ui);
  }
  .card__role {
    justify-self: start;
    margin-top: 2px;
    padding: 1px 7px;
    border-radius: var(--radius-pill);
    background: var(--accent-dark);
    color: var(--on-accent);
    font: 800 12px/1.3 var(--font-ui);
    font-style: normal;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  @media (max-width: 52rem) {
    .tree {
      min-height: 22rem;
    }
  }
</style>
