---
import { Plus } from 'lucide-static';

// The workspace heading: kicker, section title, the view switcher and the New
// button (../daena/src/lib/shell/WorkspaceHeader.svelte). Pane toggles, guide
// and secondary buttons are left out.
interface Props {
  kicker: string;
  title: string;
  nav?: string[];
  active?: number;
  create?: string;
  /** Optional demo group. Adds data-set values so the switcher can be clicked. */
  group?: string;
}

const { kicker, title, nav = [], active = 0, create, group } = Astro.props;
const navValue = (label: string) => label.toLowerCase().replace(/[^a-z0-9]+/g, '-');
---

<header class="app-heading">
  <div>
    <span class="overline">{kicker}</span>
    <div class="app-heading__title">{title}</div>
  </div>
  {
    nav.length > 0 && (
      <div class="app-nav">
        {nav.map((label, index) => (
          <span
            class:list={[{ 'is-active': index === active }]}
            data-set={group ? `${group}:${navValue(label)}` : undefined}
          >
            {label}
          </span>
        ))}
      </div>
    )
  }
  {
    create && (
      <div class="app-heading__actions">
        <span class="app-primary">
          <span set:html={Plus} />
          {create}
        </span>
      </div>
    )
  }
</header>
