---
import Wordmark from './Wordmark.astro';
import ThemeSelector from './ThemeSelector.astro';
import { navItems, siteConfig, withBase } from '../config/site';

interface Props {
  currentPath: string;
}
const { currentPath } = Astro.props;
const isActive = (href: string) => currentPath.includes(href.replace(/^\//, '').replace(/\/$/, ''));
---

<header class="site-header">
  <div class="header-inner shell">
    <a class="brand" href={withBase('/')} aria-label="Daena Archive home"><Wordmark /></a>
    <nav class="desktop-nav" aria-label="Primary navigation">
      {
        navItems.map((item) => (
          <a href={withBase(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="header-actions">
      <a class="github-link" href={siteConfig.repository}
        >GitHub <span aria-hidden="true">↗</span></a
      >
      <ThemeSelector />
      <a class="button button-primary compact" href={withBase('/download/')}>Download</a>
      <details class="mobile-menu">
        <summary aria-label="Open navigation menu"><span></span><span></span><span></span></summary>
        <nav aria-label="Mobile navigation">
          {
            navItems.map((item) => (
              <a href={withBase(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
          <a href={withBase('/faq/')} aria-current={isActive('/faq/') ? 'page' : undefined}>FAQ</a>
          <a href={siteConfig.repository}>GitHub <span aria-hidden="true">↗</span></a>
          <a href={withBase('/download/')}>Download Daena</a>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header {
    --wordmark-ink: #f2eee4;
    --wordmark-accent: #e4c786;
    --theme-control-background: rgba(255, 255, 255, 0.045);
    --theme-control-border: #43584c;
    --theme-control-color: #f2eee4;
    --theme-menu-background: #203229;
    --theme-hover-background: #2d4437;
    --theme-hover-color: #fffdf7;
    --theme-active-background: #e4c786;
    --theme-active-color: #2f2619;
    position: sticky;
    z-index: 40;
    top: 0;
    height: var(--header-height);
    border-bottom: 1px solid #354a3f;
    background: color-mix(in srgb, #17241e 96%, transparent);
    backdrop-filter: blur(14px);
  }
  .header-inner {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  .brand {
    flex: 0 0 auto;
    text-decoration: none;
  }
  .desktop-nav {
    margin-inline: auto;
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2vw, 2rem);
  }
  .desktop-nav a,
  .github-link {
    position: relative;
    color: #d8d1c3;
    font-size: 0.85rem;
    font-weight: 620;
    text-decoration: none;
  }
  .desktop-nav a::after {
    position: absolute;
    right: 0;
    bottom: -0.65rem;
    left: 0;
    height: 1px;
    background: #e4c786;
    content: '';
    transform: scaleX(0);
    transition: transform 180ms ease;
  }
  .desktop-nav a:hover::after,
  .desktop-nav a[aria-current='page']::after {
    transform: scaleX(1);
  }
  .desktop-nav a:hover,
  .desktop-nav a[aria-current='page'],
  .github-link:hover {
    color: #fffdf7;
  }
  .site-header .button-primary {
    background: #e4c786;
    color: #2f2619;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.16);
  }
  .site-header .button-primary:hover {
    background: #efd59e;
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }
  .mobile-menu {
    display: none;
    position: relative;
  }
  .mobile-menu > summary {
    width: 2.65rem;
    height: 2.65rem;
    display: grid;
    place-content: center;
    gap: 0.24rem;
    border: 1px solid #43584c;
    border-radius: 0.65rem;
    cursor: pointer;
    list-style: none;
  }
  .mobile-menu > summary::-webkit-details-marker {
    display: none;
  }
  .mobile-menu > summary span {
    width: 1rem;
    height: 1px;
    background: #f2eee4;
  }
  .mobile-menu nav {
    position: absolute;
    top: calc(100% + 0.55rem);
    right: 0;
    width: min(18rem, calc(100vw - 2rem));
    padding: 0.55rem;
    display: grid;
    border: 1px solid #43584c;
    border-radius: 0.9rem;
    background: #203229;
    box-shadow: var(--shadow-medium);
  }
  .mobile-menu nav a {
    padding: 0.8rem 0.9rem;
    border-radius: 0.55rem;
    color: #f2eee4;
    font-weight: 650;
    text-decoration: none;
  }
  .mobile-menu nav a:hover {
    background: #2d4437;
  }
  .mobile-menu nav a[aria-current='page'] {
    background: #2d4437;
    color: #efd59e;
  }
  @media (max-width: 68rem) {
    .desktop-nav,
    .github-link {
      display: none;
    }
    .header-actions {
      margin-left: auto;
    }
    .mobile-menu {
      display: block;
    }
  }
  @media (max-width: 35rem) {
    .header-actions > .button {
      display: none;
    }
  }
</style>
