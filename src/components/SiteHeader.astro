---
import Wordmark from './Wordmark.astro';
import ThemeSelector from './ThemeSelector.astro';
import { navItems, siteConfig, withBase } from '../config/site';
import { Download, Menu } from 'lucide-static';

interface Props {
  currentPath: string;
}
const { currentPath } = Astro.props;
const homePath = withBase('/').replace(/\/+$/, '') || '/';
const isActive = (href: string) => {
  if (href === '/') {
    const path = currentPath.replace(/\/+$/, '') || '/';
    return path === homePath || path === '/';
  }
  const needle = href.replace(/^\//, '').replace(/\/$/, '');
  return needle.length > 0 && currentPath.includes(needle);
};
---

<header class="topbar on-rail site-header">
  <a class="topbar__brand" href={withBase('/')} aria-label="Daena Archive home">
    <Wordmark surface="rail" />DAENA
  </a>
  <nav class="topbar__nav" aria-label="Primary navigation">
    {
      navItems.map((item) => (
        <a href={withBase(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))
    }
  </nav>
  <div class="topbar__actions">
    <a
      class="btn btn--ghost btn--icon topbar__github"
      href={siteConfig.repository}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="GitHub"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
      >
        <path
          d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
        ></path>
      </svg>
    </a>
    <ThemeSelector />
    <a class="btn btn--brass topbar__download" href={withBase('/download/')}>
      <span class="icon" aria-hidden="true" set:html={Download} />Download
    </a>
    <details class="topbar__menu">
      <summary class="btn btn--ghost btn--icon" aria-label="Open navigation menu">
        <span class="icon" aria-hidden="true" set:html={Menu} />
      </summary>
      <nav class="topbar__panel" aria-label="Mobile navigation">
        {
          navItems.map((item) => (
            <a
              class="rail__item"
              href={withBase(item.href)}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))
        }
        <a
          class="rail__item"
          href={withBase('/faq/')}
          aria-current={isActive('/faq/') ? 'page' : undefined}>FAQ</a
        >
        <a class="rail__item" href={siteConfig.repository} target="_blank" rel="noopener noreferrer"
          >GitHub</a
        >
        <a class="rail__item" href={withBase('/download/')}>Download Daena</a>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    z-index: 40;
    top: 0;
    height: 56px;
    /* Align the bar's content with the page shell on wide screens. */
    padding-inline: max(var(--space-5), calc((100% - var(--content-width)) / 2));
  }
  .site-header :global(svg) {
    width: 16px;
    height: 16px;
    flex: none;
  }
  .icon {
    display: inline-flex;
  }
  .topbar__brand {
    flex: none;
  }
  .topbar__nav {
    margin-left: var(--space-2);
  }
  .topbar__menu {
    position: relative;
    display: none;
  }
  .topbar__menu > summary {
    list-style: none;
  }
  .topbar__menu > summary::-webkit-details-marker {
    display: none;
  }
  .topbar__panel {
    position: absolute;
    z-index: 50;
    top: calc(100% + 8px);
    right: 0;
    display: grid;
    width: min(18rem, calc(100vw - 2rem));
    padding: 6px;
    border: 1px solid var(--rail-border);
    border-radius: var(--radius-lg);
    background: var(--rail-popover);
    box-shadow: var(--shadow-md);
  }
  .topbar__panel .rail__item:last-child {
    margin-bottom: 0;
  }
  @media (max-width: 45rem) {
    .site-header {
      gap: var(--space-3);
      padding-inline: var(--space-4);
    }
    .topbar__nav,
    .topbar__github {
      display: none;
    }
    .topbar__menu {
      display: block;
    }
  }
  @media (max-width: 25rem) {
    .topbar__download {
      display: none;
    }
  }
</style>

<script>
  // Close the header's native menus on outside click or Escape.
  const menus = () => document.querySelectorAll<HTMLDetailsElement>('.site-header details[open]');
  document.addEventListener('click', (event) => {
    menus().forEach((menu) => {
      if (!menu.contains(event.target as Node)) menu.removeAttribute('open');
    });
  });
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    menus().forEach((menu) => {
      menu.removeAttribute('open');
      menu.querySelector('summary')?.focus();
    });
  });
</script>
