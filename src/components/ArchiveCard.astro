---
interface Props {
  label?: string;
  title?: string;
  quote?: string;
  meta?: string;
  class?: string;
}
const {
  label = 'ELDERMERE',
  title,
  quote = 'The sea remembers what kingdoms forget.',
  meta = 'Fragments · 12',
  class: className = '',
} = Astro.props;
---

<article class:list={['archive-card', 'panel', className]}>
  <span class="overline">{label}</span>
  {title && <h3>{title}</h3>}
  <p>{quote}</p>
  <small>{meta}</small>
</article>

<style>
  .archive-card {
    width: min(17rem, 46vw);
    padding: var(--space-4) var(--space-5);
    background: var(--surface);
    box-shadow: var(--shadow-md);
    color: var(--ink);
  }
  h3 {
    margin: var(--space-2) 0 0;
    font: 500 1.125rem/1.2 var(--font-display);
  }
  p {
    margin: var(--space-2) 0 var(--space-3);
    font: 500 clamp(1.05rem, 1.5vw, 1.25rem)/1.25 var(--font-display);
    text-wrap: balance;
  }
  small {
    color: var(--ink-soft);
    font: 500 0.75rem/1.4 var(--font-ui);
  }
</style>
