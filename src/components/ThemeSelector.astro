---
import { Check, Monitor, Moon, Sun, SunMoon } from 'lucide-static';

// Behaviour lives in BaseLayout's script: it reads [data-theme-choice],
// toggles aria-pressed, fills [data-theme-label] and closes the <details>.
const choices = [
  { value: 'light', label: 'Light', icon: Sun },
  { value: 'dark', label: 'Dark', icon: Moon },
  { value: 'system', label: 'System', icon: Monitor },
] as const;
---

<details class="theme-selector">
  <summary
    class="btn btn--ghost btn--icon"
    aria-label="Choose color theme"
    title="Choose color theme"
  >
    <span class="icon" aria-hidden="true" set:html={SunMoon} />
    <span data-theme-label hidden>System</span>
  </summary>
  <div class="theme-menu" role="group" aria-label="Color theme">
    {
      choices.map((choice) => (
        <button
          type="button"
          class="rail__item"
          data-theme-choice={choice.value}
          aria-pressed={choice.value === 'system' ? 'true' : 'false'}
        >
          <span class="icon" aria-hidden="true" set:html={choice.icon} />
          {choice.label}
          <span class="check" aria-hidden="true" set:html={Check} />
        </button>
      ))
    }
  </div>
</details>

<style>
  .theme-selector {
    position: relative;
  }
  .theme-selector > summary {
    list-style: none;
  }
  .theme-selector > summary::-webkit-details-marker {
    display: none;
  }
  .icon,
  .check {
    display: inline-flex;
  }
  .theme-selector :global(svg) {
    width: 16px;
    height: 16px;
    flex: none;
  }
  .theme-menu {
    position: absolute;
    z-index: 50;
    top: calc(100% + 8px);
    right: 0;
    display: grid;
    min-width: 10rem;
    padding: 6px;
    border: 1px solid var(--rail-border);
    border-radius: var(--radius-lg);
    background: var(--rail-popover);
    box-shadow: var(--shadow-md);
  }
  .theme-menu .rail__item:last-child {
    margin-bottom: 0;
  }
  .theme-menu .rail__item[aria-pressed='true'] {
    color: var(--rail-text);
  }
  .check {
    margin-left: auto;
    visibility: hidden;
  }
  .rail__item[aria-pressed='true'] .check {
    visibility: visible;
  }
</style>
