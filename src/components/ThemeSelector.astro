---
import { Sun, Moon } from 'lucide-static';
const iconStroke = 'currentColor';
---

<button
  type="button"
  class="theme-toggle"
  data-theme-toggle
  aria-label="Toggle color theme"
  title="Toggle color theme"
>
  <span class="icon-sun" aria-hidden="true" set:html={Sun}></span>
  <span class="icon-moon" aria-hidden="true" set:html={Moon}></span>
</button>

<style>
  .theme-toggle {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.65rem;
    height: 2.65rem;
    padding: 0;
    border: 1px solid var(--theme-control-border, var(--line));
    border-radius: 0.65rem;
    color: var(--theme-control-color, var(--ink-soft));
    background: var(
      --theme-control-background,
      color-mix(in srgb, var(--paper-raised) 86%, transparent)
    );
    cursor: pointer;
  }
  .theme-toggle:hover,
  .theme-toggle:focus-visible {
    border-color: var(--theme-hover-color, var(--ink));
    color: var(--theme-hover-color, var(--ink));
  }
  .theme-toggle svg,
  .theme-toggle :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
  }
  .icon-sun,
  .icon-moon {
    display: none;
  }
</style>

<style is:global>
  :root[data-theme='light'] .theme-toggle .icon-sun,
  :root[data-theme='dark'] .theme-toggle .icon-moon {
    display: block;
  }
</style>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const button = document.querySelector('[data-theme-toggle]');
    if (!button || button.dataset.bound) return;
    button.dataset.bound = 'true';

    const sync = () => {
      const theme = root.dataset.theme === 'dark' ? 'dark' : 'light';
      button.dataset.state = theme;
      button.setAttribute(
        'aria-label',
        theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme'
      );
    };

    const apply = (next) => {
      root.dataset.theme = next;
      root.dataset.themePreference = next;
      localStorage.setItem('daena-theme', next);
      document
        .querySelector('meta[name="theme-color"]')
        ?.setAttribute('content', next === 'dark' ? '#0e1714' : '#f7f6f2');
      sync();
    };

    sync();

    button.addEventListener('click', () => {
      const current = root.dataset.theme === 'dark' ? 'dark' : 'light';
      apply(current === 'dark' ? 'light' : 'dark');
    });

    new MutationObserver(sync).observe(root, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });
  })();
</script>
