---
interface Props {
  status: 'stable' | 'beta' | 'experimental' | 'planned' | 'exploring' | string;
}
const { status } = Astro.props;
const variants: Record<string, string> = {
  stable: 'badge--success',
  beta: 'badge--info',
  experimental: 'badge--warning',
  planned: 'badge--outline',
  exploring: 'badge--outline',
};
const label = status.charAt(0).toUpperCase() + status.slice(1);
---

<span class:list={['badge', variants[status.toLowerCase()]]}>{label}</span>
