---
import { withBase } from '../config/site';

interface Props {
  /** 'rail' sits on the forest chrome (on-dark mark); 'paper' sits on a light or dark paper surface (on-light mark). */
  surface?: 'rail' | 'paper';
  /** Rendered size in CSS pixels. */
  size?: number;
}

const { surface = 'rail', size = 28 } = Astro.props;
const name = surface === 'rail' ? 'mark-on-dark' : 'mark-on-light';
---

<picture class="wordmark">
  <source
    type="image/webp"
    srcset={`${withBase(`/branding/${name}-64.webp`)} 1x, ${withBase(`/branding/${name}-128.webp`)} 2x`}
  />
  <img
    src={withBase(`/branding/${name}-64.png`)}
    alt=""
    width={size}
    height={size}
    decoding="async"
  />
</picture>

<style>
  .wordmark {
    display: inline-flex;
    flex: none;
  }
  img {
    display: block;
  }
</style>
